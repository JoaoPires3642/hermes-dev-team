# Contexto do TUPLE DESTE projeto/cliente. Cada pasta de projeto tem o seu.
# Copie para tuple.env, preencha e: chmod 600 tuple.env — nunca versionar.

# ---------------------------------------------------------------- obrigatórios
TUPLE_API_KEY=

# Não é descobrível pela API: com a chave sozinha, `workspaces.list` e `users.me`
# respondem 403 ("API keys cannot access this resource") e todo o resto exige
# workspaceId na entrada. É o valor de partida — pegue na URL do Tuple.
TUPLE_WORKSPACE_ID=

# ------------------------------------------------------------------- opcionais
# Nome (ou id) do projeto DESTE cliente. Um workspace costuma ter mais de um
# projeto, e é o bot que precisa saber qual é o desta pasta. Deixe em branco só
# se o workspace tiver exatamente um.
#   projectId e teamId NÃO vão aqui: saem de projects.list com o workspaceId.
TUPLE_PROJECT=

# Prefixo das issues (ex.: OUVI, SELL) — aparece na key: OUVI-12.
# Em branco, é lido do projeto.
TUPLE_PREFIXO=

# Base da API. Dev: https://api-dev.tuple.hypesoft.com.br
TUPLE_API_BASE=https://api.tuple.hypesoft.com.br

# ------------------------------------------------------------------------------
# Credencial git NÃO vai aqui: use o credential helper da máquina, para que o
# token nunca fique legível por um bot. Ver README, seção Segredos.
#
# Anote a data em que validou o workspaceId: ele muda se o workspace for
# recriado, e o sintoma é 403 numa chamada que antes funcionava.
# Validado em: __/__/____
