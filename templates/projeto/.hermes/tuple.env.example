# Contexto do TUPLE DESTE projeto/cliente. Cada pasta de projeto tem o seu.
# Copie para tuple.env, preencha e: chmod 600 tuple.env — nunca versionar.
#
# A chave já é escopada ao workspace, mas os IDs precisam vir junto: sem eles o
# bot teria que montar o JSON na mão, e copiar o workspaceId do projeto errado
# significa escrever no board de outro cliente.

TUPLE_API_KEY=

# Validados na API em __/__/____ (anote a data: IDs mudam quando o projeto é recriado)
TUPLE_WORKSPACE_ID=
TUPLE_PROJECT_ID=
TUPLE_TEAM_ID=

# Prefixo das issues deste projeto (ex.: OUVI, SELL) — aparece na key: OUVI-12
TUPLE_PREFIXO=

# Base da API. Dev: https://api-dev.tuple.hypesoft.com.br
TUPLE_API_BASE=https://api.tuple.hypesoft.com.br

# Credencial git NÃO vai aqui: use o credential helper da máquina, para que o
# token nunca fique legível por um bot. Ver README, seção Segredos.
