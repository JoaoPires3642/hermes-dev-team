def outras_faltas(faltas):
    resto = [f for f in faltas if f not in ("decisoes", "sem_decisoes")]
    return "\nFaltou tambem: " + ", ".join(resto) if resto else ""


# Estados em que a tarefa ainda USA a branch dela. Fora destes (CLOSED, MERGED...) o nome ja nao
# disputa nada: uma tarefa encerrada nao deve obrigar as novas a concordarem com ela.
VIVOS = {"SPECIFYING", "AWAITING_SPEC_APPROVAL", "SPEC_APPROVED", "IMPLEMENTING", "TESTING",
         "CHANGES_REQUESTED", "AWAITING_COMMIT", "AWAITING_REVIEW", "BLOCKED"}
BASES = {"main", "master", "develop", "development", "dev"}


def conflito_de_branch(root, key, estrategia, nome, base):
    """Texto do motivo se `nome` contradiz a estratégia do projeto; None se está coerente.

    `compartilhada` quer dizer UMA branch do time. O @techlead escreveu um nome por tarefa
    (feature/ouvi-148-..., fix/ouvi-150-..., develop...) em seis tarefas do mesmo projeto, todas
    `compartilhada`: o `git-bot preparar` obedecia cada uma e trocava a branch do working tree
    por baixo de quem estava nele. Ninguém conferia que estratégia e nome combinam, e uma
    regra que depende de o bot lembrar não é regra.

    - compartilhada: o nome é o MESMO de toda tarefa viva do projeto, e não é uma base
      protegida (bot não trabalha em main/develop).
    - por-tarefa: o nome carrega a KEY da própria tarefa e nenhuma outra tarefa o usa."""
    nome = (nome or "").strip()
    if not nome:
        return None
    chave = key.lower()
    if estrategia == "por-tarefa":
        if chave not in nome.lower():
            return (f"estratégia por-tarefa pede uma branch com a KEY da tarefa (feature/{chave}-<slug>); "
                    f"'{nome}' não cita {key}")
    elif estrategia == "compartilhada":
        if nome.lower() in BASES or (base and nome == base):
            return (f"'{nome}' é a base/protegida; a branch compartilhada é outra, a do time, "
                    "e vem do AGENTS.md do projeto")
    outras = {}
    for mf in sorted((root / ".hermes" / "tasks").glob("*/manifest.yaml")):
        if mf.parent.name == key:
            continue
        try:
            o = yaml.safe_load(mf.read_text(encoding="utf-8")) or {}
        except (OSError, yaml.YAMLError):
            continue
        if o.get("estado") not in VIVOS:
            continue
        b = o.get("branch") or {}
        if b.get("nome"):
            outras[mf.parent.name] = (b.get("estrategia"), b["nome"])
    if estrategia == "compartilhada":
        divergentes = {k: n for k, (e, n) in outras.items() if e == "compartilhada" and n != nome}
        if divergentes:
            lista = ", ".join(f"{k}→{n}" for k, n in sorted(divergentes.items())[:4])
            return (f"branch compartilhada é UMA só e já há tarefa viva com outro nome ({lista}); "
                    f"'{nome}' contradiz")
    elif estrategia == "por-tarefa":
        iguais = [k for k, (_, n) in outras.items() if n == nome]
        if iguais:
            return f"'{nome}' já é a branch de {', '.join(sorted(iguais))}; por-tarefa é uma branch por tarefa"
    return None


TRANSICOES = {
    ("RECEIVED", "TRIAGED"): ({"orquestrador"}, {"resumo": "arquivo"}),
    ("TRIAGED", "AWAITING_APPROVAL"): ({"po"}, {"proposta": "arquivo"}),                   # quebra do @po
    # Call que não pede trabalho (só andamento, decisão tomada, explicação): não há o que o
    # humano aprovar no GATE 1 e não há issue a criar. Fecha aqui, mas só com a informação
    # guardada em arquivo (`memoria`) e o motivo escrito — e o humano é avisado ao fim da
    # rodada (hermes-delegar), porque um bot que decide "não é trabalho" sozinho pode errar.
    ("TRIAGED", "CLOSED"): ({"orquestrador", "po"}, {"sem_trabalho": "texto", "memoria": "arquivo"}),
    ("AWAITING_APPROVAL", "SPECIFYING"): (H, {"issues": "texto", "via": "texto"}),        # GATE 1
    ("AWAITING_APPROVAL", "CLOSED"): (H, {"motivo": "texto"}),
    ("AWAITING_APPROVAL", "TRIAGED"): (H, {"motivo": "texto"}),                          # GATE 1: ajustar
    ("SPECIFYING", "CLOSED"): ({"po"}, {"issues": "texto"}),        # só CALL-N: issues criadas e passadas adiante
    # GATE 2 agora e condicional, e a condicao e "ha algo que so o humano decide".
    #
    # Em 01/10 seis issues da skymark chegaram ao GATE 2 no mesmo minuto. Tres nao
    # perguntavam nada — spec pronta, "aprova para o dev comecar". Carimbo treina a
    # aprovar sem ler, e foi o que aconteceu com a unica que importava: a OUVI-154, em
    # que o @techlead recomendava CANCELAR porque o pedido ja estava entregue, foi
    # aprovada junto com o lote e um dev comecou a reconstruir o que existia.
    #
    # Entao: tem pergunta -> pede o gate, e a pergunta vem escrita (`decisoes`). Nao tem
    # -> vai direto para o dev, e o humano recebe aviso informativo, nao gate. O DoR
    # continua valendo nos dois caminhos; o que muda e so quem destrava.
    ("SPECIFYING", "AWAITING_SPEC_APPROVAL"): ({"techlead"},
                                               {"story": "arquivo", "dor": "ok",
                                                "decisoes": "texto"}),
    ("SPECIFYING", "SPEC_APPROVED"): ({"techlead"},
                                      {"story": "arquivo", "dor": "ok",
                                       "sem_decisoes": "texto"}),
    ("AWAITING_SPEC_APPROVAL", "SPEC_APPROVED"): (H, {"via": "texto"}),                  # GATE 2
    ("AWAITING_SPEC_APPROVAL", "SPECIFYING"): (H, {"motivo": "texto"}),
    ("SPEC_APPROVED", "IMPLEMENTING"): ({"techlead"}, {"specs": "arquivo", "branch": "texto"}),
    # Recurso contra o GATE 2 dispensado. Dar ao @techlead o direito de seguir sem
    # perguntar so e aceitavel se o humano puder desfazer depois — senao e autonomia
    # sem recurso. Vale tambem quando ele percebe tarde que o trabalho nao deveria
    # existir: a OUVI-154 foi aprovada no lote e um dev comecou a reconstruir o que
    # o @techlead tinha dito que ja estava entregue.
    ("IMPLEMENTING", "SPECIFYING"): (H, {"motivo": "texto"}),
    ("IMPLEMENTING", "CLOSED"): (H, {"atendido": "texto"}),
    ("AWAITING_SPEC_APPROVAL", "CLOSED"): (H, {"atendido": "texto"}),
    ("IMPLEMENTING", "TESTING"): (DEVS, {"handoff": "arquivo"}),
    ("TESTING", "CHANGES_REQUESTED"): ({"qa"}, {"relatorio": "arquivo", "para": "texto"}),
    ("CHANGES_REQUESTED", "IMPLEMENTING"): (DEVS, {}),
    # O QA aprova, mas nao e ele quem sobe o codigo: assina o DoD e a tarefa fica
    # esperando o commit. Antes o dev commitava ANTES do QA olhar, entao codigo nao
    # verificado ja estava na branch compartilhada e a issue ia para IN_REVIEW sem
    # ninguem ter conferido. Agora commit e a ULTIMA coisa, e so acontece sobre o que
    # passou.
    ("TESTING", "AWAITING_COMMIT"): ({"qa"}, DOD),
    ("AWAITING_COMMIT", "AWAITING_REVIEW"): (DEVS, {"commit": "texto"}),
    # QA aprovou mas o commit nao subiu (conflito, push recusado): volta ao dev
    ("AWAITING_COMMIT", "CHANGES_REQUESTED"): (DEVS | {"qa"}, {"motivo": "texto", "para": "texto"}),
    ("AWAITING_REVIEW", "MERGED"): (H, {"via": "texto"}),                                 # GATE 3
    ("AWAITING_REVIEW", "CHANGES_REQUESTED"): (H, {"motivo": "texto", "para": "texto"}),
    ("MERGED", "DEPLOYED"): (H, {"deploy": "texto"}),
    ("MERGED", "HOMOLOGATING"): (H, {}),
    ("DEPLOYED", "HOMOLOGATING"): (H, {}),
    **{(e, "CLOSED"): (H, {}) for e in FINAIS},
}


def agora():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg, code=1):
    print(f"hermes-task: {msg}", file=sys.stderr)
    sys.exit(code)


def projeto(p):
    root = Path(p).expanduser().resolve()
    if not (root / "AGENTS.md").is_file():
        die(f"{root} não é pasta de projeto (sem AGENTS.md)", 2)
    return root


def paths(root, key):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", key):
        die(f"KEY inválida: {key}", 2)
    d = root / ".hermes" / "tasks" / key
    return d, d / "manifest.yaml"


def audit(root, **ev):
    (root / ".hermes").mkdir(exist_ok=True)
    with open(root / ".hermes" / "audit.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps({"ts": agora(), **ev}, ensure_ascii=False) + "\n")


def load(mf):
    if not mf.is_file():
        die(f"tarefa não existe: {mf}")
    return yaml.safe_load(mf.read_text(encoding="utf-8"))


def save(mf, m):
    # encoding explicito: `allow_unicode=True` emite o acento de verdade e o
    # write_text sem encoding grava no codec do locale (cp1252 no Windows).
    # O manifest saia cp1252 e todo mundo o le como utf-8 -- um titulo com
    # acento derrubava o call-dispatch na releitura da propria tarefa.
    mf.write_text(yaml.safe_dump(m, allow_unicode=True, sort_keys=False),
                  encoding="utf-8", newline="\n")


def parse_ev(pairs):
    ev = {}
    for p in pairs or []:
        if "=" not in p:
            die(f"evidência deve ser chave=valor: {p}", 2)
        k, v = p.split("=", 1)
        ev[k.strip()] = v.strip()
    return ev


def checa_ev(root, exig, ev):
    faltas = []
    for k, tipo in exig.items():
        v = ev.get(k, "")
        if tipo == "arquivo":
            if not v or not (root / v).expanduser().exists() and not Path(v).expanduser().exists():
                faltas.append(f"{k} (arquivo que exista)")
        elif tipo == "texto":
            if not v:
                faltas.append(k)
        else:  # "ok" ou "ok|na"
            if v not in tipo.split("|"):
                faltas.append(f"{k}={tipo}")
    return faltas


def worktree_da_tarefa(repo, key):
    """Caminho do worktree que o `git-bot preparar --key` criou para esta tarefa, ou None.
    Com worktree por tarefa o trabalho do dev NÃO está na árvore principal; olhar só lá faria o
    DoD ver zero arquivos, e a árvore principal ainda carrega a sujeira das outras tarefas."""
    saida = subprocess.run(["git", "-C", str(repo), "worktree", "list", "--porcelain"], capture_output=True,
                           text=True, encoding="utf-8", errors="replace", creationflags=SEM_JANELA).stdout
    for bloco in saida.split("\n\n"):
        linhas = dict(l.split(" ", 1) for l in bloco.splitlines() if " " in l)
        p = linhas.get("worktree")
        if p and Path(p).name == key and Path(p).resolve() != Path(repo).resolve() and Path(p).is_dir():
            return Path(p)
    return None


def arquivos_da_tarefa(root, m):
    """Mudança LÍQUIDA da tarefa: arquivos tocados por commits que citam a KEY e que ainda
    diferem de antes do 1º desses commits, + mudanças não commitadas."""
    out = set()
    repos = m.get("repos") or []
    # string única ("partner-hub-admin-vertem") itera como caracteres, não como um
    # repo. É a forma que os manifests deste projeto usam.
    if isinstance(repos, str):
        repos = [x.strip() for x in repos.split(",") if x.strip()]
    for r in repos:
        # `repos` é escrito à mão e chega em três formas: string única
        # ("partner-hub"), lista de strings, ou lista de dicts {path: ...}. Exigir
        # só a última travou o DoD de tarefa pronta: o walker estourava TypeError
        # ANTES de gravar audit, então o QA via a transição falhar sem motivo no log.
        caminho = r.get("path") if isinstance(r, dict) else r
        if not caminho:
            continue
        repo = root / caminho
        if not (repo / ".git").exists():
            continue
        repo = worktree_da_tarefa(repo, m["task_id"]) or repo
        g = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=SEM_JANELA).stdout
        # `Refs: <KEY>` e não a KEY solta: o corpo de um commit costuma citar outra
        # task ("usa o recálculo de SELL-78"), e o grep frouxo atribuía os arquivos
        # daquele commit a esta tarefa — o DoD reprovava por "fora de allowed_paths"
        # arquivos que eram de outra issue. É o `Refs:` que declara a dona do commit.
        grep = f"--grep=Refs: {m['task_id']}"
        tocados = {l for l in g("log", "-n", "500", grep, "--name-only", "--format=").splitlines() if l.strip()}
        shas = g("log", "-n", "500", grep, "--format=%H").split()
        if tocados and shas:
            antes = g("rev-parse", "--verify", "-q", shas[-1] + "^").strip() or "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
            liquido = set(g("diff", "--name-only", antes, "HEAD", "--", *sorted(tocados)).split())
        else:
            liquido = set()
        st = g("status", "--porcelain")
        liquido |= {l[3:].split(" -> ")[-1] for l in st.splitlines() if len(l) > 3}
        out |= {str(PurePosixPath(caminho) / f) for f in liquido}
    return sorted(out)


def fora_do_escopo(root, m, agente=None):
    ap = m.get("allowed_paths") or {}

    def normalizar(v):
        # allowed_paths também é escrito à mão: vem como lista OU como string com
        # vírgulas. String crua entraria inteira como um "glob" que nunca casa, e
        # TODO arquivo apareceria fora do escopo — inclusive os permitidos.
        if isinstance(v, str):
            return [x.strip() for x in v.split(",") if x.strip()]
        return list(v or [])

    globs = normalizar(ap.get(agente)) if agente else [g for v in ap.values() for g in normalizar(v)]
    if not globs:
        return None  # sem escopo definido
    ruins = []
    for f in arquivos_da_tarefa(root, m):
        alvo = PurePosixPath(f)
        # caminho literal (o que o @techlead grava) casa por igualdade; glob por
        # full_match. Antes só o glob era testado, então caminho exato = "fora".
        if not any(str(alvo) == g or alvo.full_match(g) for g in globs):
            ruins.append(f)
    return ruins


def cmd_new(a):
    root = projeto(a.projeto)
    d, mf = paths(root, a.key)
    if mf.exists():
        die(f"tarefa já existe: {mf}")
    agentes = [x.strip() for x in a.agentes.split(",") if x.strip()]
    if not set(agentes) <= BOTS:
        die(f"agentes inválidos: {agentes}", 2)
    # Issue nascida de uma call já aprovada: o GATE 1 foi dado na call (CALL-N), não
    # nesta KEY. Ela nasce em SPECIFYING com a aprovação herdada — e só se a call
    # tiver mesmo passado pelo GATE 1, senão seria um jeito de pular o gate.
    herdado = None
    if a.herda_gate1:
        _, mf_call = paths(root, a.herda_gate1)
        call = load(mf_call)
        g1 = (call.get("aprovacoes") or {}).get("gate1")
        if not g1:
            audit(root, tipo="negado", task=a.key, motivo=f"herda-gate1 de {a.herda_gate1} sem GATE 1")
            die(f"NEGADO: {a.herda_gate1} não tem GATE 1 aprovado")
        herdado = {**g1, "herdado_de": a.herda_gate1}
    (d / "handoffs").mkdir(parents=True)
    m = {
        "task_id": a.key, "objetivo": a.objetivo, "estado": "RECEIVED", "estado_anterior": None,
        "escopo": {"incluido": [], "excluido": []}, "criterios_aceite": [], "restricoes_tecnicas": [],
        "agentes": agentes, "tem_ui": a.ui, "risco": "medio",
        "branch": {"estrategia": None, "nome": None, "base": None},
        "repos": [], "allowed_paths": {x: [] for x in agentes if x in DEVS},
        "aprovacoes": {"gate1": None, "gate2": None, "gate3": None},
        "voltas_qa": 0, "max_voltas": 3, "handoffs_dev": [],
        "artefatos": {"resumo": None, "proposta": None, "story": None, "contrato": None, "specs": None,
                      "relatorio_testes": None, "revisao": None, "pr": None, "screenshots": []},
        "historico": [{"em": agora(), "para": "RECEIVED", "por": "orquestrador"}],
    }
    if herdado:
        m["estado"] = "SPECIFYING"
        m["aprovacoes"]["gate1"] = herdado
        m["historico"].append({"em": agora(), "de": "RECEIVED", "para": "SPECIFYING",
                               "por": "gate1-herdado", "evidencias": {"call": a.herda_gate1}})
    save(mf, m)
    audit(root, tipo="new", task=a.key, agentes=agentes, herda_gate1=a.herda_gate1)
    print(mf)


def cmd_show(a):
    root = projeto(a.projeto)
    _, mf = paths(root, a.key)
    print(mf.read_text(encoding="utf-8") if mf.exists() else die(f"tarefa não existe: {mf}"))


TRAVADOS_APOS_SPEC = {"agentes", "allowed_paths", "escopo", "criterios_aceite", "tem_ui"}
ABERTOS = {"RECEIVED", "TRIAGED", "AWAITING_APPROVAL", "SPECIFYING"}
CAMPOS_SET = {"objetivo", "tem_ui", "risco", "agentes", "repos", "criterios_aceite", "restricoes_tecnicas",
              "escopo", "branch", "allowed_paths", "artefatos", "depende_de"}


def cmd_set(a):
    root = projeto(a.projeto)
    _, mf = paths(root, a.key)
    with trava(mf):
        m = load(mf)
        for kv in a.pares:
            k, _, v = kv.partition("=")
            topo = k.split(".")[0]
            if topo not in CAMPOS_SET:
                die(f"campo não editável por set: {topo} (estado/aprovações só via move)", 2)
            if topo in TRAVADOS_APOS_SPEC and m["estado"] not in ABERTOS and a.by.lstrip("@") != "humano":
                audit(root, tipo="negado", task=a.key, por=a.by, motivo=f"set {topo} após spec aprovada")
                die(f"NEGADO: {topo} fica travado depois da spec (estado {m['estado']}); só humano muda")
            try:
                val = yaml.safe_load(v)
            except yaml.YAMLError:
                val = v
            if k == "depende_de":
                deps = lista_de(val)
                ciclo = dependencia_circular(root, a.key, deps)
                faltando = [d for d in deps if manifest_de(root, d) is None]
                if a.key in deps or ciclo or faltando:
                    motivo = (f"{a.key} não pode depender de si mesma" if a.key in deps else
                              f"dependência circular ({ciclo}): as duas esperariam uma pela outra para sempre"
                              if ciclo else f"depende_de aponta para tarefa que não existe aqui: {', '.join(faltando)}")
                    audit(root, tipo="negado", task=a.key, por=a.by, motivo=f"set depende_de: {motivo}")
                    die(f"NEGADO: {motivo}")
            alvo, partes = m, k.split(".")
            for p in partes[:-1]:
                alvo = alvo.setdefault(p, {})
            alvo[partes[-1]] = val
            if k in ("branch.nome", "branch.estrategia", "branch.base", "branch") and a.by.lstrip("@") != "humano":
                b = m.get("branch") or {}
                if isinstance(val, dict):
                    b = {**b, **val}
                motivo = conflito_de_branch(root, a.key, b.get("estrategia"), b.get("nome"), b.get("base"))
                if motivo:
                    audit(root, tipo="negado", task=a.key, por=a.by, motivo=f"set {k}: {motivo}")
                    die(f"NEGADO: {motivo}. Use o nome do AGENTS.md do projeto; na dúvida, pergunte ao humano.")
        save(mf, m)
    audit(root, tipo="set", task=a.key, por=a.by, campos=[p.split("=")[0] for p in a.pares])
    print("ok")


def cmd_move(a):
    root = projeto(a.projeto)
    _, mf = paths(root, a.key)
    por, para = a.by.lstrip("@"), a.estado.upper()
    ev = parse_ev(a.ev)
    if por not in ATORES:
        die(f"ator desconhecido: {por}", 2)
    if para not in ESTADOS:
        die(f"estado desconhecido: {para} (veja: hermes-task states)", 2)

    with trava(mf):
        m = load(mf)
        de = m["estado"]

        def negar(motivo):
            audit(root, tipo="negado", task=a.key, de=de, para=para, por=por, motivo=motivo)
            die(f"NEGADO {de} → {para} por @{por}: {motivo}")

        # BLOCKED: qualquer ator entra; só humano sai (volta ao estado anterior)
        if para == "BLOCKED":
            if not ev.get("motivo"):
                negar("BLOCKED exige --ev motivo=...")
            m["estado_anterior"], m["estado"] = de, "BLOCKED"
        elif de == "BLOCKED":
            if por != "humano":
                negar("só humano tira uma tarefa de BLOCKED")
            if para != m.get("estado_anterior") and para != "CLOSED":
                negar(f"sai de BLOCKED para o estado anterior ({m.get('estado_anterior')}) ou CLOSED")
            if ev.get("reset_voltas") == "sim":
                m["voltas_qa"] = 0
            m["estado"], m["estado_anterior"] = para, None
        else:
            regra = TRANSICOES.get((de, para))
            if not regra:
                negar(f"transição não existe a partir de {de}")
            quem, exig = regra
            if por not in quem:
                negar(f"quem pode: {', '.join(sorted(quem))}")
            if (de, para) in (("SPECIFYING", "CLOSED"), ("TRIAGED", "CLOSED")) \
                    and not a.key.upper().startswith("CALL-"):
                negar("só a tarefa de uma call (CALL-N) fecha assim; issue fecha no GATE 3")
            exig = dict(exig)
            if de == "SPECIFYING" and para in ("AWAITING_SPEC_APPROVAL", "SPEC_APPROVED"):
                erro_br = conferir_branch(a.key, m.get("branch"))
                if erro_br:
                    negar(erro_br)
                if DEVS <= set(m["agentes"]):
                    exig["contrato"] = "arquivo"  # front e back em paralelo: contrato antes
                sem_escopo = [d for d in m["agentes"] if d in DEVS and not (m.get("allowed_paths") or {}).get(d)]
                if sem_escopo:
                    negar(f"defina allowed_paths para: {', '.join(sem_escopo)}")
            if (de, para) == ("SPEC_APPROVED", "IMPLEMENTING") and ev.get("branch"):
                b = m.get("branch") or {}
                motivo = conflito_de_branch(root, a.key, b.get("estrategia"), ev["branch"], b.get("base"))
                if motivo:
                    negar(f"branch={ev['branch']}: {motivo}")
            if (de, para) == ("SPEC_APPROVED", "IMPLEMENTING"):
                espera = bloqueio_de_sequencia(root, a.key, m)
                if espera:
                    negar(espera)
            if (de, para) == ("TESTING", "AWAITING_COMMIT") and m.get("tem_ui"):
                exig["evidencia_visual"] = "arquivo"
            faltas = checa_ev(root, exig, ev)
            if faltas:
                # Recusa que nao diz o que fazer custa uma rodada inteira. Em 01/10,
                # quando o GATE 2 passou a ser condicional, sete issues da skymark
                # estavam paradas em SPECIFYING: cada @techlead delas ia receber so
                # "faltou evidência: decisoes", sem como saber que havia caminho novo.
                if de == "SPECIFYING" and {"decisoes", "sem_decisoes"} & set(faltas):
                    negar(CAMINHOS_GATE2 + outras_faltas(faltas))
                negar("faltou evidência: " + ", ".join(faltas))

            if (de, para) == ("IMPLEMENTING", "TESTING"):
                feitos = set(m.get("handoffs_dev") or []) | {por}
                m["handoffs_dev"] = sorted(feitos)
                faltam = [d for d in m["agentes"] if d in DEVS and d not in feitos]
                if faltam:
                    m["historico"].append({"em": agora(), "handoff": por, "evidencias": ev})
                    save(mf, m)
                    audit(root, tipo="handoff", task=a.key, por=por, aguardando=faltam)
                    print(f"handoff de @{por} registrado; TESTING só depois de: {', '.join(faltam)}")
                    return
            if (de, para) == ("TESTING", "AWAITING_COMMIT"):
                ruins = fora_do_escopo(root, m)
                if ruins:
                    negar("arquivos fora de allowed_paths: " + ", ".join(ruins[:10]))
            m["estado"] = para

            if para == "CHANGES_REQUESTED":
                alvo = ev.get("para", "").lstrip("@")
                m["handoffs_dev"] = [d for d in m.get("handoffs_dev") or [] if d != alvo]
                if por == "qa":
                    m["voltas_qa"] = int(m.get("voltas_qa") or 0) + 1
            gates = {("AWAITING_APPROVAL", "SPECIFYING"): "gate1",
                     ("AWAITING_SPEC_APPROVAL", "SPEC_APPROVED"): "gate2",
                     ("AWAITING_REVIEW", "MERGED"): "gate3"}
            if (de, para) in gates:
                m["aprovacoes"][gates[(de, para)]] = {"em": agora(), "via": ev.get("via")}
            if (de, para) == ("SPECIFYING", "SPEC_APPROVED"):
                # Nao foi aprovado: foi dispensado, e o manifest tem de distinguir as
                # duas coisas. Quem auditar depois precisa saber que ninguem olhou, e
                # por que o @techlead disse que nao havia o que olhar.
                m["aprovacoes"]["gate2"] = {"em": agora(), "via": None,
                                            "dispensado": ev.get("sem_decisoes")}
            for k in ("resumo", "proposta", "story", "contrato", "specs", "revisao", "pr", "memoria"):
                if k in ev:
                    m["artefatos"][k] = ev[k]
            if "relatorio" in ev:
                m["artefatos"]["relatorio_testes"] = ev["relatorio"]
            if "branch" in ev:
                m["branch"]["nome"] = ev["branch"]

        m["historico"].append({"em": agora(), "de": de, "para": m["estado"], "por": por, "evidencias": ev})

        disparou = False
        if m["estado"] == "CHANGES_REQUESTED" and por == "qa" and m["voltas_qa"] >= m.get("max_voltas", 3):
            m["estado_anterior"], m["estado"], disparou = "CHANGES_REQUESTED", "BLOCKED", True
            m["historico"].append({"em": agora(), "de": "CHANGES_REQUESTED", "para": "BLOCKED",
                                   "por": "circuit-breaker", "evidencias": {"voltas_qa": m["voltas_qa"]}})
        save(mf, m)

    audit(root, tipo="transicao", task=a.key, de=de, para=m["estado"], por=por, evidencias=ev,
          circuit_breaker=disparou or None)
    if a.key.upper().startswith("CALL-"):
        print(f"{de} → {m['estado']}  ·  (tarefa da call: não existe no TUPLE, não mova nada lá)")
    else:
        # O board é espelho do manifest e se move junto — em código, não em prosa.
        estado_tuple, detalhe = sincronizar_tuple(root, a.key, m["estado"], ev.get("motivo", ""))
        print(f"{de} → {m['estado']}  ·  {detalhe}")
        audit(root, tipo="tuple-sync", task=a.key, estado=m["estado"],
              resultado=estado_tuple, detalhe=detalhe)
        if estado_tuple == "erro":
            print(f"AVISO: o TUPLE não acompanhou ({detalhe}). A transição local VALE; "
                  f"ajuste o board na mão ou avise o humano.", file=sys.stderr)
    if disparou:
        print(f"CIRCUIT BREAKER: {m['voltas_qa']} voltas QA⇄DEV. Tarefa BLOCKED — alerte o humano "
              "no Telegram com o histórico e não reabra o loop.", file=sys.stderr)
        sys.exit(3)


def _tuple(root, *args, timeout=60):
    """Chama o tuple-api. No Windows ele é um shell script sem extensão: o
    subprocess não o executa direto (FileNotFoundError), só via bash."""
    cmd = ["tuple-api", str(root), *args]
    if sys.platform == "win32":
        cmd = ["bash", "-lc", " ".join(shlex.quote(c) for c in cmd)]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, creationflags=SEM_JANELA)


def sincronizar_tuple(root, key, estado, motivo=""):
    """Move a issue no TUPLE junto com a transição local.

    Existia como instrução em prosa ("TUPLE: mova para X") e dependia de o bot
    lembrar de obedecer. Três vezes o board ficou mentindo: task em
    desenvolvimento com o card em TODO, e quem descobriu foi o humano. Aqui é
    código, então não tem como esquecer.

    Falha de rede/403 NÃO derruba a transição local: o manifest é a fonte da
    verdade do fluxo, e o board é espelho. Devolve o que aconteceu, para o
    chamador imprimir.
    """
    alvo = TUPLE_STATUS[estado]

    # CANCELLED e DUPLICATE são TERMINAIS no workflow do TUPLE: entrou, não sai por
    # API (recusa saída para os 7 outros status) e só uma pessoa desfaz na interface.
    # Bot nunca escreve isso — a skill já dizia "só com OK humano"; aqui é código.
    if alvo in ("CANCELLED", "DUPLICATE"):
        return ("pulado", f"TUPLE intocado: {alvo} é terminal e só humano aplica")

    # BLOCKED por limitação do ambiente local (build sem credencial, feed privado,
    # VPN) não é impedimento do trabalho: pintar o card de vermelho alarma o time
    # inteiro por algo que é da máquina, não da task. Fica só no manifest.
    if alvo == "BLOCKED" and re.search(
        r"\b(build|lint|feed privado|sem PAT|E401|credencia|VPN|nao autentica|"
        r"não autentica|ambiente local|waiver|node_modules|dev server)\b", motivo, re.I
    ):
        return ("pulado", "TUPLE intocado: BLOCKED por ambiente local, não pelo trabalho")

    try:
        ctx = _tuple(root, "contexto")
        if ctx.returncode:
            return ("erro", "não consegui o contexto do TUPLE")
        ws = json.loads(ctx.stdout).get("workspaceId")
        if not ws:
            return ("erro", "workspaceId ausente no contexto")

        r = _tuple(root, "get", "issues.getByKey",
                   json.dumps({"key": key, "workspaceId": ws}))
        if r.returncode:
            return ("erro", f"issue {key} não encontrada no TUPLE")
        dados = json.loads(r.stdout)["result"]["data"]
        issue = dados.get("issue", dados)
        if issue.get("status") == alvo:
            return ("ok", f"TUPLE já estava em {alvo}")

        u = _tuple(root, "post", "issues.update",
                   json.dumps({"id": issue["id"], "status": alvo}))
        if u.returncode:
            return ("erro", f"issues.update falhou para {alvo}")
        return ("ok", f"TUPLE movido para {alvo}")
    except Exception as e:                                    # rede, timeout, JSON
        return ("erro", f"{type(e).__name__}")


def cmd_check(a):
    root = projeto(a.projeto)
    _, mf = paths(root, a.key)
    m = load(mf)
    ruins = fora_do_escopo(root, m, a.agente)
    if ruins is None:
        die("allowed_paths vazio para esse filtro")
    if ruins:
        print("fora do escopo:\n  " + "\n  ".join(ruins))
        sys.exit(1)
    print("ok: todos os arquivos dentro de allowed_paths")


def cmd_states(_):
    print("Estados:", " → ".join(ESTADOS[:-1]), "· BLOCKED (qualquer ator entra; só humano sai)\n")
    for (de, para), (quem, exig) in TRANSICOES.items():
        print(f"{de:24} → {para:24} por {','.join(sorted(quem)):28} evidência: {', '.join(exig) or '—'}")
    print("\nSPECIFYING→AWAITING_SPEC_APPROVAL também exige contrato (se front+back) e allowed_paths de cada dev.")
    print("TESTING→AWAITING_COMMIT (DoD, do @qa) exige evidencia_visual se tem_ui e confere allowed_paths.")
    print("AWAITING_COMMIT→AWAITING_REVIEW é do dev: commit e push do que o QA aprovou.")
    print("IMPLEMENTING→TESTING só avança quando todos os devs da tarefa entregaram handoff.")


def main():
    p = argparse.ArgumentParser(prog="hermes-task", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    s = p.add_subparsers(dest="cmd", required=True)
    n = s.add_parser("new"); n.add_argument("projeto"); n.add_argument("key")
    n.add_argument("--objetivo", required=True); n.add_argument("--agentes", required=True)
    n.add_argument("--ui", action="store_true"); n.add_argument("--herda-gate1", dest="herda_gate1")
    n.set_defaults(f=cmd_new)
    x = s.add_parser("show"); x.add_argument("projeto"); x.add_argument("key"); x.set_defaults(f=cmd_show)
    x = s.add_parser("set"); x.add_argument("projeto"); x.add_argument("key"); x.add_argument("pares", nargs="+")
    x.add_argument("--by", required=True); x.set_defaults(f=cmd_set)
    x = s.add_parser("move"); x.add_argument("projeto"); x.add_argument("key"); x.add_argument("estado")
    x.add_argument("--by", required=True); x.add_argument("--ev", action="append"); x.set_defaults(f=cmd_move)
    x = s.add_parser("check-paths"); x.add_argument("projeto"); x.add_argument("key"); x.add_argument("--agente")
    x.set_defaults(f=cmd_check)
    x = s.add_parser("states"); x.set_defaults(f=cmd_states)
    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
