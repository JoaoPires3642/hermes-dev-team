    "RECEIVED", "TRIAGED", "AWAITING_APPROVAL", "SPECIFYING", "AWAITING_SPEC_APPROVAL",
    "SPEC_APPROVED", "IMPLEMENTING", "TESTING", "CHANGES_REQUESTED", "AWAITING_COMMIT", "AWAITING_REVIEW",
    "MERGED", "DEPLOYED", "HOMOLOGATING", "CLOSED", "BLOCKED",
]

# status do TUPLE que acompanha cada estado (o bot move no TUPLE via tuple-api)
TUPLE_STATUS = {
    "RECEIVED": "BACKLOG", "TRIAGED": "BACKLOG", "AWAITING_APPROVAL": "BACKLOG",
    "SPECIFYING": "TODO", "AWAITING_SPEC_APPROVAL": "TODO", "SPEC_APPROVED": "TODO",
    "IMPLEMENTING": "IN_PROGRESS", "TESTING": "IN_PROGRESS", "CHANGES_REQUESTED": "IN_PROGRESS",
    # aprovado pelo QA e ainda sem commit: para quem olha o board, continua em andamento
    "AWAITING_COMMIT": "IN_PROGRESS",
    "AWAITING_REVIEW": "IN_REVIEW", "MERGED": "IN_REVIEW", "DEPLOYED": "IN_REVIEW",
    "HOMOLOGATING": "IN_REVIEW", "CLOSED": "DONE", "BLOCKED": "BLOCKED",
}

# evidência: "arquivo" = caminho que precisa existir · "ok" = precisa ser ok · "texto" = não vazio
#
# `build` e `lint_typecheck` aceitam `na` pelo mesmo motivo que `integracao` já aceitava:
# há projeto onde o comando não roda nesta máquina e nunca vai rodar — o feed npm privado
# do agregador exige PAT, e bot não manuseia PAT. Exigir `ok` ali não torna o build
# verificado: só faz o QA recusar e o humano assinar um waiver por tarefa, para sempre.
#
# `na` não é atalho: quem assina escreve `na` explicitamente, e isso aparece no manifest,
# no audit e no comentário da issue. A diferença entre "passou" e "não foi verificado"
# continua visível para quem revisa — que é a única coisa que o DoD precisa garantir aqui.
# O projeto declara o que não roda no próprio `AGENTS.md`.
DOD = {
    "build": "ok|na", "lint_typecheck": "ok|na", "testes": "ok", "integracao": "ok|na",
    "seguranca": "ok", "ca": "ok", "revisao": "arquivo", "tuple": "ok",
}

H = {"humano"}
FINAIS = {"MERGED", "DEPLOYED", "HOMOLOGATING"}
def conferir_branch(key, br):
    """`compartilhada` quer dizer UMA branch do time. Devolve o erro, ou None.

    Em 01/10 o @techlead escreveu `estrategia: compartilhada` nos seis manifests da
    skymark e, no mesmo campo `nome`, pos feature/ouvi-148-... (148), develop (149),
    fix/ouvi-150-... (150), null (152), develop (153) e feature/ouvi-154-... (154).
    Nao era so incoerente com a estrategia — era incoerente entre si.

    O estrago nao foi teorico: ha UM working tree por repo, e os devs com branch propria
    trocaram o checkout por baixo um do outro. 13:12:24 develop -> feature/ouvi-148,
    13:18:36 ouvi-148 -> feature/ouvi-154. `git checkout` CARREGA alteracao nao
    commitada quando nao ha conflito, entao o codigo da 148 reapareceu na branch da 154
    e a arvore ficou com arquivos de tres tarefas.

    A regra morava na skill e dependia de o bot lembrar — e regra que depende de lembrar
    nao e regra.
    """
    est = (br or {}).get("estrategia")
    nome = ((br or {}).get("nome") or "").strip()
    if not est:
        return "branch.estrategia nao definida (compartilhada ou por-tarefa, do AGENTS.md)"
    if not nome:
        return ("branch.nome vazio: sem ele o dev nao tem onde trabalhar "
                "(`git-bot preparar` recusa)")
    if est == "compartilhada" and key.lower().replace("-", "") in \
            nome.lower().replace("-", "").replace("/", ""):
        return ("branch.estrategia e 'compartilhada' (uma branch do time) mas "
                "branch.nome '%s' e desta tarefa. Ha UM working tree por repo: duas "
                "tarefas com branch propria trocam o checkout uma da outra e misturam o "
                "codigo. Use a branch do time do AGENTS.md, ou mude a estrategia para "
                "'por-tarefa' — e ai cada dev precisa de working tree separado."
                % nome)
    return None


ENTREGUES = {"AWAITING_REVIEW", "MERGED", "DEPLOYED", "HOMOLOGATING", "CLOSED"}
ATIVAS = {"IMPLEMENTING", "TESTING", "CHANGES_REQUESTED", "AWAITING_COMMIT"}


def lista_de(v):
    """depende_de / allowed_paths chegam como lista OU string com vírgulas (escritos à mão)."""
    if isinstance(v, str):
        return [x.strip() for x in v.split(",") if x.strip()]
    return [str(x).strip() for x in (v or []) if str(x).strip()]


def prefixo_de(glob):
    """Parte literal de um allowed_path: o que vem antes do primeiro curinga, até a última barra.
    `web/src/cases/**` → `web/src/cases/`; `web/src/lib/closure-block.ts` → ele mesmo."""
    g = glob.strip().replace("\\", "/")
    i = next((n for n, c in enumerate(g) if c in "*?[{"), None)
    if i is None:
        return g
    return g[:g.rfind("/", 0, i) + 1]


def caminhos_se_tocam(a, b):
    """Dois allowed_paths podem tocar o mesmo arquivo? Conservador: na dúvida diz que sim, e o
    custo é serializar duas tarefas, não misturar o código delas."""
    pa, pb = prefixo_de(a), prefixo_de(b)
    if pa == pb:
        return True
    return (pa.endswith("/") and pb.startswith(pa)) or (pb.endswith("/") and pa.startswith(pb))


def manifest_de(root, key):
    mf = root / ".hermes" / "tasks" / key / "manifest.yaml"
    try:
        return yaml.safe_load(mf.read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError):
        return None


def bloqueio_de_sequencia(root, key, m):
    """Motivo se esta tarefa NÃO pode começar a implementar agora; None se pode.

    Em 01/10 a OUVI-149 criava o `lossKind` e a OUVI-148 condicionava a devolução a ele, as duas
    no mesmo formulário: sequenciais, não paralelas. O fluxo as rodou juntas porque nada dizia
    que uma esperava a outra. Duas regras, as duas em código:
    - `depende_de`: a tarefa só começa depois que cada dependência foi ENTREGUE (commitada e em
      revisão, ou além) — é o que dá ao dev o código de que ele precisa;
    - allowed_paths: não começa se outra tarefa ATIVA pode tocar os mesmos arquivos. Worktree
      separado evita misturar a árvore, mas não o conflito de merge nem a dependência de
      significado, e bot não resolve conflito de código alheio."""
    for dep in lista_de(m.get("depende_de")):
        d = manifest_de(root, dep)
        if d is None:
            return f"depende_de {dep}, que não existe neste projeto (confira a KEY)"
        if d.get("estado") not in ENTREGUES:
            return (f"depende de {dep}, que está em {d.get('estado')}: só começa quando {dep} chegar a "
                    "AWAITING_REVIEW (ou além). Deixe esta tarefa em SPEC_APPROVED")
    meus = [g for v in (m.get("allowed_paths") or {}).values() for g in lista_de(v)]
    for mf in sorted((root / ".hermes" / "tasks").glob("*/manifest.yaml")):
        outra = mf.parent.name
        if outra == key:
            continue
        o = manifest_de(root, outra) or {}
        if o.get("estado") not in ATIVAS:
            continue
        deles = [g for v in (o.get("allowed_paths") or {}).values() for g in lista_de(v)]
        comuns = [(x, y) for x in meus for y in deles if caminhos_se_tocam(x, y)]
        if comuns:
            x, y = comuns[0]
            return (f"{outra} está em {o.get('estado')} e pode tocar os mesmos arquivos ({x} × {y}). "
                    f"São sequenciais, não paralelas: declare `set depende_de={outra}` nesta tarefa "
                    f"(e a relação BLOCKS no TUPLE) e espere {outra} chegar a AWAITING_REVIEW. "
                    "Deixe esta tarefa em SPEC_APPROVED")
    return None


def dependencia_circular(root, key, deps):
    """Primeiro ciclo que `key → deps` fecharia, como 'A → B → A'; None se não há."""
    for dep in deps:
        visto, fila = [key, dep], [dep]
        while fila:
            atual = fila.pop()
            for prox in lista_de((manifest_de(root, atual) or {}).get("depende_de")):
                if prox == key:
                    return " → ".join(visto + [atual, key])
                if prox not in visto:
                    visto.append(prox)
                    fila.append(prox)
    return None


