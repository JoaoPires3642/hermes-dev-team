#!/usr/bin/env python3
"""openwhispr-notes — exporta as reuniões do OpenWhispr como Markdown para o @orquestrador.

Irmão do `meetily-notes`: mesma saída, mesma pasta, mesmo agendador. Só muda a fonte.
Os dois podem conviver — cada um tem sua própria marca d'água.

O OpenWhispr (MIT, transcrição e diarização locais) guarda tudo em
%APPDATA%/open-whispr/transcriptions.db. A API e o MCP deles são em NUVEM e pedem
plano pago, então aqui se lê o SQLite local: de graça e sem o áudio sair da máquina.

  openwhispr-notes novas   [--inbox DIR] [--db PATH]   # só as reuniões ainda não exportadas
  openwhispr-notes todas   [--inbox DIR] [--db PATH]   # reexporta tudo
  openwhispr-notes onde                                # mostra o banco e a inbox

Cliente/projeto vem da PASTA da reunião no OpenWhispr (crie uma por cliente, como no
Granola). Pasta padrão (Personal/Meetings/Videos) cai para o prefixo "[Cliente]" do
título; sem nada disso, vai para `_sem-cliente` e o @orquestrador pergunta.

Diferença importante para o meetily-notes: aqui existe quem-falou (`speaker_mappings`),
então a transcrição sai com os nomes.

Códigos de saída: 0 ok · 1 erro · 2 uso
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path
# No Windows cada subprocess abre uma janela de console que pisca na tela. Numa rodada
# de teste sao centenas; num turno de bot, uma a cada ferramenta chamada. Este flag
# existe so no Windows; nos outros sistemas o valor e 0 e nao muda nada.
SEM_JANELA = getattr(subprocess, "CREATE_NO_WINDOW", 0)


DB_NOME = "transcriptions.db"
MARCA = ".ultima-exportacao-openwhispr.json"
LOG = ".openwhispr-notes.log"
TRAVA = ".exportando.lock"
FILA = ".novas.txt"  # fila do @orquestrador: o que ele ainda não viu
# pastas que o app cria sozinho: não são cliente
PASTAS_PADRAO = {"personal", "meetings", "videos", "inbox", "general"}

for _fluxo in (sys.stdout, sys.stderr):
    try:
        _fluxo.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, OSError):
        pass


def _do_env_hermes(nome):
    raiz = Path(os.getenv("HERMES_HOME") or (
        Path(os.getenv("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "hermes"
        if sys.platform == "win32" else Path.home() / ".hermes"))
    if raiz.parent.name == "profiles":
        raiz = raiz.parent.parent
    try:
        for linha in (raiz / ".env").read_text(encoding="utf-8", errors="replace").splitlines():
            if linha.startswith(nome + "="):
                return os.path.expanduser(linha.split("=", 1)[1].strip().strip("\"'")) or None
    except OSError:
        pass
    return None


def inbox_padrao():
    """Onde as notas de call são escritas.

    De propósito NÃO é a pasta dos projetos. Os projetos moram no OneDrive
    corporativo e sincronizam; transcrição de call de cliente fica **local**, fora
    da sincronização — o motivo de usar OpenWhispr foi justamente transcrever sem
    o áudio sair da máquina. Pasta de OneDrive é ignorada aqui mesmo que exista.

    HERMES_CALLS manda, se definida — no ambiente ou no ~/.hermes/.env (agendado, o
    job não herda o shell do usuário; e o call-dispatch lê do mesmo lugar, então os
    dois concordam sobre onde fica a pasta).
    """
    env = os.getenv("HERMES_CALLS") or _do_env_hermes("HERMES_CALLS")
    if env:
        return Path(env) if env.endswith("_calls") else Path(env) / "_calls"

    casa = Path.home()
    for nome in ("Documentos", "Documents"):
        d = casa / nome
        if d.is_dir() and "onedrive" not in str(d).lower():
            return d / "_calls"
    return casa / "Documentos" / "_calls"


def registrar(inbox, msg):
    """Roda agendado sem console: sem este log, falha é invisível."""
    try:
        with open(Path(inbox) / LOG, "a", encoding="utf-8") as fh:
            fh.write(dt.datetime.now().isoformat(timespec="seconds") + "  " + msg + "\n")
    except OSError:
        pass


def erro(msg, inbox=None):
    if inbox:
        registrar(inbox, "ERRO: " + msg)
    print("\033[1;31m[erro]\033[0m " + msg, file=sys.stderr)
    sys.exit(1)


def achar_db(explicito, inbox=None):
    if explicito:
        p = Path(explicito)
        if not p.is_file():
            erro("banco não encontrado: " + str(p), inbox)
        return p
    candidatos = []
    if sys.platform == "win32":
        raiz = os.getenv("APPDATA")
        if raiz:
            candidatos += list(Path(raiz).glob("*/" + DB_NOME))
    elif sys.platform == "darwin":
        base = Path.home() / "Library" / "Application Support"
        candidatos += list(base.glob("*/" + DB_NOME))
    else:
        base = Path(os.getenv("XDG_CONFIG_HOME") or (Path.home() / ".config"))
        candidatos += list(base.glob("*/" + DB_NOME))
    candidatos = [p for p in candidatos if "whispr" in str(p).lower()]
    if not candidatos:
        erro("não achei o " + DB_NOME + " do OpenWhispr. O app está instalado? "
             "Se sim, passe o caminho com --db.", inbox)
    return max(candidatos, key=lambda p: p.stat().st_mtime)


def abrir_somente_leitura(db):
    """Copia banco + WAL e lê da cópia: nunca disputa lock com o app aberto."""
    tmp = Path(tempfile.mkdtemp(prefix="openwhispr-notes-"))
    shutil.copy2(db, tmp / db.name)
    for sufixo in ("-wal", "-shm"):
        origem = db.with_name(db.name + sufixo)
        if origem.exists():
            shutil.copy2(origem, tmp / (db.name + sufixo))
    con = sqlite3.connect("file:" + str(tmp / db.name).replace("\\", "/") + "?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    return con


def slug(txt):
    s = re.sub(r"[^\w\s-]", "", txt or "", flags=re.UNICODE).strip().lower()
    return re.sub(r"[\s_-]+", "-", s).strip("-")[:60] or "sem-titulo"


def cliente_do_titulo(titulo):
    m = re.match(r"^\s*\[([^\]]+)\]\s*(.*)$", titulo or "")
    if not m:
        m = re.match(r"^\s*([^\-–—]{2,40}?)\s*[\-–—]\s*(.+)$", titulo or "")
    if m:
        return m.group(1).strip(), (m.group(2).strip() or (titulo or "").strip())
    return None, (titulo or "").strip()


def tabelas(con):
    return {r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")}


def render_transcricao(bruto, nomes):
    """O OpenWhispr guarda o transcript como JSON de segmentos, não texto:
    [{"text","source":"mic"|"system","speaker":"you"|"speaker_N","timestamp"}, ...]

    Vira diálogo legível, agrupando falas seguidas do mesmo interlocutor. `source`
    separa quem fala: "mic" é o dono da máquina, "system" é o outro lado da call —
    numa 1:1 isso vale mais que diarização genérica. `nomes` (de speaker_mappings)
    substitui speaker_N pelo nome real quando o usuário tiver nomeado as vozes.
    """
    bruto = (bruto or "").strip()
    if not bruto:
        return ""
    if not bruto.startswith("["):
        return bruto  # já é texto puro (versão antiga do app, ou formato mudou)
    try:
        segmentos = json.loads(bruto)
    except ValueError:
        return bruto
    if not isinstance(segmentos, list):
        return bruto

    def quem(seg):
        chave = str(seg.get("speaker") or "")
        if chave in nomes:
            return nomes[chave]
        if chave == "you" or seg.get("source") == "mic":
            return "você"
        return chave.replace("speaker_", "voz ") if chave else "desconhecido"

    linhas, atual, acumulado = [], None, []
    for seg in segmentos:
        if not isinstance(seg, dict):
            continue
        texto = (seg.get("text") or "").strip()
        if not texto:
            continue
        falante = quem(seg)
        if falante != atual:
            if acumulado:
                linhas.append("**" + atual + "**: " + " ".join(acumulado))
            atual, acumulado = falante, [texto]
        else:
            acumulado.append(texto)
    if acumulado:
        linhas.append("**" + atual + "**: " + " ".join(acumulado))
    return "\n\n".join(linhas)


def ler_reunioes(con):
    presentes = tabelas(con)
    if "notes" not in presentes:
        erro("este banco não parece ser do OpenWhispr (sem tabela 'notes')")

    pastas = {}
    if "folders" in presentes:
        pastas = {r["id"]: (r["name"] or "") for r in con.execute("SELECT id, name FROM folders")}

    colunas = {d[1] for d in con.execute("PRAGMA table_info(notes)")}
    def tem(c):
        return c in colunas

    reunioes = []
    for n in con.execute("SELECT * FROM notes ORDER BY created_at"):
        if tem("deleted_at") and n["deleted_at"]:
            continue
        transcricao = (n["transcript"] if tem("transcript") else "") or ""
        conteudo = (n["content"] if tem("content") else "") or ""
        melhorado = (n["enhanced_content"] if tem("enhanced_content") else "") or ""
        if not (transcricao.strip() or conteudo.strip() or melhorado.strip()):
            continue  # nota vazia não vira nota de call

        pasta = pastas.get(n["folder_id"] if tem("folder_id") else None, "") or ""
        do_titulo, assunto = cliente_do_titulo(n["title"] if tem("title") else "")
        if pasta and pasta.strip().lower() not in PASTAS_PADRAO:
            cliente = pasta.strip()
        elif do_titulo:
            cliente = do_titulo
        else:
            cliente = "_sem-cliente"

        nomes = {}
        if "speaker_mappings" in presentes:
            for r in con.execute(
                    "SELECT speaker_id, display_name FROM speaker_mappings "
                    "WHERE note_id = ? AND display_name IS NOT NULL AND display_name <> ''",
                    (n["id"],)):
                nomes[str(r["speaker_id"])] = r["display_name"]
        vozes = sorted(set(nomes.values()))

        reunioes.append({
            "id": str(n["id"]),
            "cliente": cliente,
            "pasta": pasta,
            "assunto": assunto or "(sem título)",
            "criado_em": (n["created_at"] if tem("created_at") else "") or "",
            "atualizado_em": (n["updated_at"] if tem("updated_at") else "") or "",
            "duracao": (n["audio_duration_seconds"] if tem("audio_duration_seconds") else None),
            "participantes": (n["participants"] if tem("participants") else "") or "",
            "vozes": vozes,
            "notas": melhorado.strip() or conteudo.strip(),
            "transcricao": render_transcricao(transcricao, nomes),
        })
    return reunioes


def corpo_da_nota(r):
    """O que a nota DIZ (notas + transcrição), na forma exata em que vai para o .md.

    É isto que se compara entre uma exportação e a seguinte: o texto de uma call só
    cresce no fim (fala nova), então o que já foi exportado é o começo do atual."""
    partes = []
    if r["notas"]:
        partes += ["## Notas", "", r["notas"], ""]
    if r["transcricao"]:
        partes += ["## Transcrição", "", r["transcricao"], ""]
    return "\n".join(partes).strip()


def impressao(texto):
    return hashlib.sha1(texto.encode("utf-8")).hexdigest()


def corpo_ja_exportado(inbox, r):
    """Notas exportadas ANTES de existir o registro por nota (`notas` na marca) não dizem
    o que já saiu. Quem diz é o próprio .md daquela exportação: o corpo começa no 1º
    cabeçalho `## Notas`/`## Transcrição`. None = o arquivo não está mais lá."""
    data = str(r["criado_em"])[:10] or dt.date.today().isoformat()
    caminho = inbox / slug(r["cliente"]) / (data + "-" + slug(r["assunto"]) + ".md")
    try:
        texto = caminho.read_text(encoding="utf-8")
    except OSError:
        return None
    m = re.search(r"^## (Notas|Transcrição)$", texto, re.M)
    return texto[m.start():].strip() if m else None


def escrever_nota(r, inbox, parte=None, acrescimo=None):
    """Nota inteira (parte=None) ou só o que entrou depois da exportação anterior.

    Antes, nota editada depois de exportada nunca mais saía: a marca d'água era o
    `created_at`, e acrescentar fala numa nota existente não o muda — o @orquestrador
    não via a call nova. `parte` é o nº da parte (2, 3...) e `acrescimo` o trecho novo."""
    data = str(r["criado_em"])[:10] or dt.date.today().isoformat()
    if parte:
        data = str(r["atualizado_em"] or r["criado_em"])[:10] or data
    assunto = r["assunto"]
    if parte:
        assunto += " (parte %d)" % parte
    destino = inbox / slug(r["cliente"])
    destino.mkdir(parents=True, exist_ok=True)
    base = data + "-" + slug(r["assunto"]) + ("-parte-%d" % parte if parte else "")
    caminho = destino / (base + ".md")
    while parte and caminho.exists():
        parte += 1
        caminho = destino / (data + "-" + slug(r["assunto"]) + "-parte-%d.md" % parte)

    cab = ["---",
           "note_id: " + r["id"],
           "cliente: " + r["cliente"],
           "titulo: " + assunto,
           "criado_em: " + str((r["atualizado_em"] if parte else r["criado_em"]) or r["criado_em"]),
           "fonte: openwhispr"]
    if parte:
        cab.append("continuacao_da_nota: " + r["id"])
    if r["pasta"]:
        cab.append("pasta: " + r["pasta"])
    if r["vozes"]:
        cab.append("vozes: " + ", ".join(r["vozes"]))
    cab.append("---")

    partes = cab + ["", "# " + assunto, ""]
    if parte:
        # o @orquestrador resume o que lê: sem este aviso ele trataria como call inteira
        # o que é só o final de uma nota cujo começo já foi triado.
        partes += ["> Cliente: **" + r["cliente"] + "** · continuação da nota " + r["id"] + ", "
                   "acrescentada em " + data + ". **Só o trecho novo**: o que veio antes já foi "
                   "triado em outra call. Transcrita localmente pelo OpenWhispr.", ""]
        if r["vozes"]:
            partes += ["## Quem falou", "", ", ".join(r["vozes"]), ""]
        partes += ["## Transcrição", "", acrescimo.strip(), ""]
        caminho.write_text("\n".join(partes), encoding="utf-8")
        return caminho

    resumo = "> Cliente: **" + r["cliente"] + "** · call de " + data
    if r["duracao"]:
        try:
            resumo += " · " + str(round(float(r["duracao"]) / 60)) + " min"
        except (TypeError, ValueError):
            pass
    partes += [resumo + " · transcrita localmente pelo OpenWhispr.", ""]

    if r["vozes"]:
        partes += ["## Quem falou", "", ", ".join(r["vozes"]), ""]
    elif r["participantes"]:
        partes += ["## Participantes", "", r["participantes"], ""]
    corpo = corpo_da_nota(r)
    if corpo:
        partes += [corpo, ""]

    caminho.write_text("\n".join(partes), encoding="utf-8")
    return caminho


def main():
    ap = argparse.ArgumentParser(description="Exporta as reuniões do OpenWhispr como Markdown.")
    ap.add_argument("comando", choices=("novas", "todas", "onde"))
    ap.add_argument("--db", help="caminho do " + DB_NOME + " (padrão: detecta sozinho)")
    padrao = inbox_padrao()
    ap.add_argument("--inbox", default=str(padrao), help="pasta de saída (padrão: " + str(padrao) + ")")
    ap.add_argument("--ao-criar", dest="ao_criar", default=None,
                    help="comando a rodar SÓ quando houver nota nova (acorda o @orquestrador)")
    args = ap.parse_args()

    inbox = Path(args.inbox)
    db = achar_db(args.db, inbox if args.comando != "onde" else None)

    if args.comando == "onde":
        print("banco: " + str(db))
        print("inbox: " + str(inbox))
        return

    inbox.mkdir(parents=True, exist_ok=True)

    # Uma execução por vez. Sem isso, uma rodada agendada que não achou nada reescreve
    # a fila como vazia no meio de outra que acabou de enfileirar — e o @orquestrador,
    # já acordado, lê uma fila vazia e perde a nota.
    trava = inbox / TRAVA
    try:
        fd = os.open(str(trava), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        idade = dt.datetime.now().timestamp() - trava.stat().st_mtime
        if idade < 600:   # outra execução em andamento
            registrar(inbox, "pulei: outra execucao em andamento")
            return
        trava.unlink(missing_ok=True)   # trava órfã de execução que morreu
        fd = os.open(str(trava), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    os.close(fd)
    try:
        _exportar(args, db, inbox)
    finally:
        trava.unlink(missing_ok=True)


# Conta caracteres SEM espaço nem rótulo de falante (ver `normalizar`): ~200 deles são duas
# frases. Abaixo disso é "ok", "certo", uma palavra corrigida — não é conversa nova.
MIN_ACRESCIMO = 200


ROTULO = re.compile(r"^\*\*[^*\n]+\*\*: ", re.M)


def normalizar(corpo):
    """(texto, mapa): o corpo sem rótulo de falante e sem espaço, e onde cada caractere dele
    estava no corpo original.

    Comparar o texto renderizado não serve: o OpenWhispr refaz a diarização depois, e a mesma
    fala que saiu como `**voz 16**: ...` num parágrafo vira continuação de outro. Em dado real
    (nota 7), o texto exportado diverge do atual no caractere 3.403 só por isso — e a fala é
    a mesma. O que identifica o que já saiu é o que foi DITO, na ordem."""
    fora = set()
    for m in ROTULO.finditer(corpo):
        fora.update(range(m.start(), m.end()))
    mapa = [i for i, c in enumerate(corpo) if i not in fora and not c.isspace()]
    return "".join(corpo[i] for i in mapa), mapa


def referencia(corpo):
    """O que guardar de um corpo exportado para reconhecê-lo depois: o tamanho e a
    impressão digital do que foi dito (ver `normalizar`), nunca o texto."""
    norm, _ = normalizar(corpo)
    return {"n": len(norm), "sha_n": impressao(norm)}


def decidir(r, inbox, reg, desde):
    """O que fazer com uma nota: ("nova", None) · ("parte", trecho) · ("nada", motivo).

    `reg` = a referência guardada na marca (ou None). A marca só guardava `created_at`,
    então nota editada depois de exportada nunca mais saía."""
    corpo = corpo_da_nota(r)
    if not reg:
        if not desde or str(r["criado_em"]) > desde:
            return "nova", None
        # exportada antes de a marca guardar o corpo: o .md daquela exportação diz o que saiu
        ja = corpo_ja_exportado(inbox, r)
        if ja is None:
            return "nada", "sem-registro"
        reg = referencia(ja)
    norm, mapa = normalizar(corpo)
    if len(norm) == reg["n"] and impressao(norm) == reg["sha_n"]:
        return "nada", None
    if len(norm) < reg["n"] or impressao(norm[:reg["n"]]) != reg["sha_n"]:
        return "nada", "reescrita"             # mexeram no que já saiu, não só acrescentaram
    if len(norm) - reg["n"] < MIN_ACRESCIMO:
        return "nada", "acrescimo-pequeno"     # a marca não avança: acumula até valer
    inicio = mapa[reg["n"]]
    rotulo = re.search(r"\*\*[^*\n]+\*\*: \s*$", corpo[:inicio])
    return "parte", corpo[rotulo.start() if rotulo else inicio:]


def _exportar(args, db, inbox):
    marca = inbox / MARCA
    desde, registro = "", {}
    if marca.is_file():
        try:
            dados = json.loads(marca.read_text(encoding="utf-8"))
        except ValueError:
            dados = {}
        if args.comando == "novas":
            desde = dados.get("ate", "")
        registro = dados.get("notas") or {}

    con = abrir_somente_leitura(db)
    try:
        reunioes = ler_reunioes(con)
    finally:
        con.close()

    criados, novos_registros = [], dict(registro)
    for r in reunioes:
        corpo = corpo_da_nota(r)
        if args.comando == "todas":
            acao, extra = "nova", None
        else:
            acao, extra = decidir(r, inbox, registro.get(r["id"]), desde)
        if acao == "nova":
            caminho = escrever_nota(r, inbox)
            criados.append(caminho)
            print(caminho)
            novos_registros[r["id"]] = referencia(corpo)
        elif acao == "parte":
            caminho = escrever_nota(r, inbox, parte=2, acrescimo=extra)
            criados.append(caminho)
            print(caminho)
            registrar(inbox, "nota %s cresceu: parte nova em %s (%d chars)" % (r["id"], caminho.name, len(extra)))
            novos_registros[r["id"]] = referencia(corpo)
        elif extra == "acrescimo-pequeno":
            registrar(inbox, "nota %s cresceu pouco (<%d chars): espero acumular" % (r["id"], MIN_ACRESCIMO))
        else:
            if extra == "reescrita":
                registrar(inbox, "nota %s: texto alterado antes do fim, nao so acrescentado — "
                                 "nao exportei; passa a ser a referencia (`todas` reexporta)" % r["id"])
            if extra in ("reescrita", "sem-registro") or r["id"] not in registro:
                novos_registros[r["id"]] = referencia(corpo)   # a referência de agora
    novas = criados

    # Fila para o @orquestrador. Ele NÃO controla o que já leu: a routine dele roda a
    # cada 15 min e, sem isso, re-triava as mesmas notas indefinidamente (a ponto de
    # tentar desligar a própria routine). Quem sabe o que é novo é este script, então
    # é ele que diz. Reescrito a cada execução: vazio = nada novo = bot fica em silêncio.
    (inbox / FILA).write_text(
        "\n".join(str(c) for c in criados) + ("\n" if criados else ""), encoding="utf-8")

    # Acorda o bot SÓ quando há nota nova. Com a routine disparando sozinha a cada 15
    # min, ele reprocessava as mesmas notas: o prompt manda responder [SILENT] com a
    # fila vazia, mas ele desconfia do arquivo vazio, vai conferir a pasta e re-triage
    # assim mesmo. Não dá para resolver no texto — resolve-se não chamando.
    if criados and args.ao_criar:
        registrar(inbox, "disparando: " + args.ao_criar)
        try:
            saida = subprocess.run(args.ao_criar, shell=True, capture_output=True,
                                   text=True, timeout=120, creationflags=SEM_JANELA)
            if saida.returncode:
                registrar(inbox, "gatilho falhou (%d): %s" %
                          (saida.returncode, (saida.stderr or "").strip()[:200]))
        except (OSError, subprocess.SubprocessError) as exc:
            registrar(inbox, "gatilho não executou: %s" % exc)

    if reunioes:
        marca.write_text(json.dumps(
            {"ate": max(str(r["criado_em"]) for r in reunioes),
             "exportado_em": dt.datetime.now().isoformat(timespec="seconds"),
             "notas": novos_registros},
            ensure_ascii=False), encoding="utf-8")

    registrar(inbox, str(len(novas)) + " nota(s) de " + str(len(reunioes)) + " reuniao(oes)")
    print("\n" + str(len(novas)) + " nota(s) nova(s) em " + str(inbox), file=sys.stderr)


if __name__ == "__main__":
    main()
