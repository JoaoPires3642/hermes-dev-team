#!/usr/bin/env python
"""skill-review — colhe o que os bots escreveram nas proprias skills e classifica.

    skill-review colher                 # o que divergiu do repo, sem julgar
    skill-review analisar [--json]      # classifica cada divergencia
    skill-review aplicar [--sim]        # leva as SEGURAS para o repo e commita
    skill-review quarentena <bot> <skill> [--motivo ...]
    skill-review pendentes              # o que espera decisao humana
    skill-review guardiao [--forcar]    # barra commit que apaga trava de SOUL/shared
                                        # e commit que sobe o modelo de um bot

Por que existe
--------------
Bot que melhora a propria skill e o que faz o time aprender. Tambem e como um bot se
da autoridade que ninguem deu: em 29/09 o @pm reescreveu a `pm-board-cadence` deixando
a DESCRICAO dizendo "propoe fechamento, nunca fecha" e o CORPO dizendo "Move old
IN_REVIEW to DONE", mais uma secao de bulk-assign. Quem lesse so a descricao aprovava.

De cinco skills escritas por bot ate 30/09, uma fez isso. As outras quatro restringiram.
Entao o problema nao e "bot nao deve escrever skill" — e nao ter quem leia o diff.

A divisao aqui e deliberada: **o catastrofico e codigo, o resto e julgamento.**
O @manutencao decide o que e boa mudanca; ele NAO decide se uma mudanca tirou uma trava,
se a versao nao subiu ou se um bot mexeu na skill de outro. Isso o codigo responde
sozinho, igual sempre, e ele nao tem como se convencer do contrario.
"""

from __future__ import annotations

import argparse
import difflib
import io
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
# No Windows cada subprocess abre uma janela de console que pisca na tela. Numa rodada
# de teste sao centenas; num turno de bot, uma a cada ferramenta chamada. Este flag
# existe so no Windows; nos outros sistemas o valor e 0 e nao muda nada.
SEM_JANELA = getattr(subprocess, "CREATE_NO_WINDOW", 0)


for _f in (sys.stdout, sys.stderr):
    try:
        _f.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass

OK, ERRO, USO = 0, 1, 2
SEGURO, GATE, NEGAR = "SEGURO", "GATE", "NEGAR"

# Vocabulario de permissao. Mencionar isto nao e crime -- as melhores skills de hoje
# mencionam para se PROIBIR ("--by humano e bloqueado para bot, nao tente contornar").
# Por isso mencao vira GATE (humano le), nunca NEGAR automatico.
PERMISSAO = re.compile(
    r"\bDONE\b|--by[ =]humano|\bgate\b|aprovar?\b|allowed_paths|\bmerge\b|--force|"
    r"assigneeId|bulk\s+assign|pode\s+(?:fechar|aprovar|mergear|pular)|"
    r"sem\s+(?:aprova|revis|autoriza)|ignore?\s+o\s+gate", re.I)

# Linha que EXISTE para impedir alguma coisa. Remover uma dessas e o padrao que
# transformou a pm-board-cadence 1.1.0 em problema: nao se nega por mencionar trava,
# nega-se por APAGAR trava.
# Linha de lista YAML com um glob de comando dentro: `    - "*git*commit*"`.
# Reconhece pela forma, nao pelo conteudo — o ponto e justamente nao depender de
# entender o que o glob proibe.
_ENTRADA_DENY = re.compile(r"^\s*-\s+.*\*")

# Degrau de PRECO do modelo, nao de qualidade. Medido em 01/10 pelo custo por milhao
# de token relido: haiku 0,30 · sonnet 0,40-0,65 · opus 1,22. Serve para o guardiao
# saber o que e descer e o que e subir.
DEGRAU = {"haiku": 1, "fable": 2, "sonnet": 2, "opus": 3}
_MODELO = re.compile(r"claude-[a-z]+-[0-9][a-z0-9-]*")
# Escrito pelo gen_bots.py dentro do config.yaml quando o modelo foi escolhido pelo
# que o papel exige, nao pelo preco.
_FIXO = "modelo fixado (so humano troca)"

TRAVA = re.compile(
    # Radicais, nao formas exatas: a primeira versao tinha "aprove" e deixou passar
    # "nao aprova o que nao rodou" — a mesma trava, outra conjugacao. Falso positivo
    # aqui custa um `--forcar` do humano; falso negativo custa uma trava apagada.
    r"\bnunca\b|\bjamais\b|"
    r"\bn[ãa]o\s+(?:mov|mex|fa[çc]|tent|aprov|pod|dev|commit|toqu|entr|escrev|"
    r"cri|registr|alter|execut|insist|adivinh|chut)\w*|"
    r"\bproibid|\brecus\w*|\bbloquead\w*|\bvedad\w*|"
    r"\bexige\s+(?:OK|autoriza|aprova)|\bs[óo]\s+(?:o\s+)?humano|"
    r"\bs[óo]\s+a\s+revis|\bnever\b|\bdoes\s+NOT\b|\bdo\s+not\b|\bmust\s+not\b",
    re.I)


# Vocabulario de PLATAFORMA. Skill que fala disso e trabalho do dono da plataforma, nao
# de quem orquestra cliente. Em 01/10 a `instalar-plataforma-bots` estava com o
# @orquestrador: ele a escreveu antes do @manutencao existir, e ninguem notou depois —
# porque `analisar` compara profile contra repo e so ve MUDANCA. Atribuicao errada
# parada nao e diff, e por isso passava.
PLATAFORMA_VOCAB = re.compile(
    r"install-windows\.sh|hermes-dev-team|gateway_state|hermes gateway|"
    r"profile install|profiles/<bot>|gen_bots\.py|shared-skills/", re.I)
DONO_DA_PLATAFORMA = "manutencao"


def repo() -> Path:
    return Path(os.getenv("HERMES_DEV_TEAM") or Path(__file__).resolve().parent.parent)


def raiz_hermes() -> Path:
    env = os.getenv("HERMES_HOME")
    if env:
        p = Path(env)
        return p.parent.parent if p.parent.name == "profiles" else p
    if sys.platform == "win32":
        return Path(os.getenv("LOCALAPPDATA", str(Path.home()))) / "hermes"
    return Path.home() / ".hermes"


def donos() -> dict:
    """{skill: bot} para as de bot, e {skill: '*'} para as compartilhadas.

    Le o gen_bots.py, que e a fonte: quem edita skill de outro bot nao esta melhorando
    o proprio trabalho, esta mexendo no de alguem.
    """
    d = {s.name: "*" for s in (repo() / "shared-skills").iterdir() if s.is_dir()}
    try:
        texto = (repo() / "scripts" / "gen_bots.py").read_text(encoding="utf-8")
    except OSError:
        return d
    for m in re.finditer(r'"([\w-]+)":\s*\{(.*?)\n    \},', texto, re.S):
        bot, corpo = m.group(1), m.group(2)
        ex = re.search(r'"extra_skills":\s*\[(.*?)\]', corpo, re.S)
        if ex:
            for nome in re.findall(r'"([\w-]+)"', ex.group(1)):
                d[nome] = bot
    return d


def caminho_repo(skill: str) -> Path | None:
    for base in ("shared-skills", "extra-skills"):
        p = repo() / base / skill / "SKILL.md"
        if p.is_file():
            return p
    return None


def versao(texto: str) -> str:
    m = re.search(r"^version:\s*(.+)$", texto, re.M)
    return m.group(1).strip() if m else ""


def descricao(texto: str) -> str:
    m = re.search(r"^description:\s*(.+)$", texto, re.M)
    return m.group(1).strip() if m else ""


def colher() -> list[dict]:
    """Skills no profile que divergem do repo, ou que o repo nem conhece."""
    perfis = raiz_hermes() / "profiles"
    if not perfis.is_dir():
        return []
    dono = donos()
    achados = []
    for prof in sorted(p for p in perfis.iterdir() if (p / "skills").is_dir()):
        raiz_sk = prof / "skills"
        for sk in sorted(raiz_sk.rglob("SKILL.md")):
            # As nossas instalam PLANAS (skills/<nome>/SKILL.md); as do catalogo do
            # Hermes vem aninhadas numa familia (skills/creative/archify/SKILL.md).
            # Usar a profundidade e melhor que listar o catalogo: ele muda sozinho a
            # cada versao, e a lista ficaria velha sem ninguem notar.
            if len(sk.relative_to(raiz_sk).parts) != 2:
                continue
            nome = sk.parent.name
            alvo = caminho_repo(nome)
            atual = sk.read_text(encoding="utf-8", errors="replace")
            antes = alvo.read_text(encoding="utf-8", errors="replace") if alvo else ""
            if antes == atual:
                continue
            achados.append({
                "bot": prof.name, "skill": nome, "nova": alvo is None,
                "arquivo": str(sk), "destino": str(alvo) if alvo else "",
                "dono": dono.get(nome, "?"), "antes": antes, "depois": atual,
            })
    return achados


def analisar(a: dict) -> dict:
    """Veredito + motivos. As regras abaixo nao sao opiniaveis: o bot nao as reavalia."""
    motivos, veredito = [], SEGURO
    linhas = list(difflib.unified_diff(
        a["antes"].splitlines(), a["depois"].splitlines(), lineterm="", n=0))
    saiu = [l[1:] for l in linhas if l.startswith("-") and not l.startswith("---")]
    entrou = [l[1:] for l in linhas if l.startswith("+") and not l.startswith("+++")]

    def pior(v):
        nonlocal veredito
        ordem = {SEGURO: 0, GATE: 1, NEGAR: 2}
        if ordem[v] > ordem[veredito]:
            veredito = v

    # --- NEGAR: nao depende de julgamento ------------------------------------
    travas_removidas = [l.strip() for l in saiu if TRAVA.search(l)]
    if travas_removidas:
        pior(NEGAR)
        motivos.append("removeu %d linha(s) que existiam para impedir algo: %s"
                       % (len(travas_removidas), travas_removidas[0][:90]))

    if a["dono"] not in ("*", "?", a["bot"]) and not a["nova"]:
        pior(NEGAR)
        motivos.append("skill e do @%s, quem mexeu foi o @%s" % (a["dono"], a["bot"]))

    if not a["nova"]:
        v0, v1 = versao(a["antes"]), versao(a["depois"])
        if v0 == v1:
            pior(NEGAR)
            motivos.append("conteudo mudou e version continuou %s — sem bump nada "
                           "sinaliza a mudanca" % (v0 or "(ausente)"))

    # Descricao suavizada enquanto o corpo mexe em permissao: o padrao exato da
    # pm-board-cadence 1.1.0, onde ler so a descricao levava a aprovar.
    if (not a["nova"]
            and descricao(a["antes"]) != descricao(a["depois"])
            and any(PERMISSAO.search(l) for l in entrou)):
        pior(NEGAR)
        motivos.append("mudou a descricao E mexeu em permissao no corpo — "
                       "foi assim que a pm-board-cadence 1.1.0 passou")

    # --- GATE: valido, mas quem decide e o humano ----------------------------
    if a["dono"] == "*" and not a["nova"]:
        pior(GATE)
        motivos.append("skill compartilhada: regra do time inteiro, nao de um bot")

    mencoes = [l.strip() for l in entrou if PERMISSAO.search(l)]
    if mencoes:
        pior(GATE)
        motivos.append("fala de permissao em %d linha(s) nova(s) — pode ser restricao "
                       "(bom) ou autorizacao (nao): %s" % (len(mencoes), mencoes[0][:80]))

    if a["nova"]:
        pior(GATE)
        motivos.append("skill nova: ninguem definiu que este bot deveria ter esta")

    if len(entrou) > 120:
        pior(GATE)
        motivos.append("%d linhas novas: grande demais para aprovar sem ler" % len(entrou))

    if veredito == SEGURO:
        motivos.append("+%d/-%d linhas, sem tocar permissao, versao subiu, skill e dele"
                       % (len(entrou), len(saiu)))
    return {"veredito": veredito, "motivos": motivos,
            "entrou": len(entrou), "saiu": len(saiu)}


def git(*args, check=True):
    p = subprocess.run(["git", "-C", str(repo()), *args], capture_output=True,
                       text=True, encoding="utf-8", errors="replace", creationflags=SEM_JANELA)
    if check and p.returncode:
        raise RuntimeError("git %s: %s" % (" ".join(args), (p.stderr or p.stdout).strip()))
    return p


def pasta_pendentes() -> Path:
    d = raiz_hermes() / "skill-review"
    d.mkdir(parents=True, exist_ok=True)
    return d


def guardar_pendente(a: dict, r: dict) -> Path:
    f = pasta_pendentes() / ("%s__%s.json" % (a["bot"], a["skill"]))
    dados = {k: a[k] for k in ("bot", "skill", "nova", "arquivo", "destino", "dono")}
    dados.update({"veredito": r["veredito"], "motivos": r["motivos"],
                  "em": datetime.now().isoformat(timespec="seconds")})
    f.write_text(json.dumps(dados, ensure_ascii=False, indent=1), encoding="utf-8")
    return f


# ------------------------------------------------------------------ comandos
def cmd_colher(_a):
    achados = colher()
    if not achados:
        print("nada divergente: o que os bots usam e o que o repo tem")
        return OK
    for a in achados:
        print("%-14s %-30s %s" % (a["bot"], a["skill"],
                                  "NOVA" if a["nova"] else "modificada"))
    return OK


def cmd_analisar(a):
    achados = colher()
    saida = []
    for d in achados:
        r = analisar(d)
        saida.append({"bot": d["bot"], "skill": d["skill"], **r})
        if r["veredito"] != SEGURO:
            guardar_pendente(d, r)
    if a.json:
        print(json.dumps(saida, ensure_ascii=False, indent=1))
        return OK
    if not saida:
        print("nada a analisar")
        return OK
    for s in saida:
        marca = {SEGURO: "[ok]  ", GATE: "[GATE]", NEGAR: "[NEGA]"}[s["veredito"]]
        print("%s @%-12s %-28s +%d/-%d" % (marca, s["bot"], s["skill"],
                                           s["entrou"], s["saiu"]))
        for m in s["motivos"]:
            print("         %s" % m)
    return OK


def cmd_aplicar(a):
    achados = colher()
    levadas = []
    for d in achados:
        r = analisar(d)
        if r["veredito"] != SEGURO:
            guardar_pendente(d, r)
            continue
        levadas.append((d, r))
    if not levadas:
        print("nenhuma mudanca SEGURA; o resto esta em %s" % pasta_pendentes(),
              file=sys.stderr)
        return OK
    print("vai levar para o repo:")
    for d, r in levadas:
        print("  @%-12s %-28s +%d/-%d" % (d["bot"], d["skill"], r["entrou"], r["saiu"]))
    if not a.sim:
        print("\nnada feito. repita com --sim", file=sys.stderr)
        return USO
    # A defesa que nao depende de shell nem de prompt: o @manutencao tem write_file e
    # podia reescrever o proprio criterio. Aqui o commit RECUSA se o que esta para
    # entrar toca as travas dele. Um revisor que reescreve a regra nao revisa nada --
    # e ele vai, um dia, estar convencido de que a mudanca faz sentido.
    # `custo-plataforma` entra aqui porque e a regua com que ele justifica proposta
    # de economia. Revisor que ajusta a propria regua prova o que quiser.
    intocaveis = ("bin/skill-review", "bin/custo-plataforma",
                  "souls/manutencao", "bots/manutencao",
                  "prompts/manutencao-rodada")
    sujo = git("status", "--porcelain").stdout.splitlines()
    proibidos = [l[3:].strip() for l in sujo
                 if any(t in l.replace("\\", "/") for t in intocaveis)]
    if proibidos:
        print("skill-review: recusado — este commit tocaria as proprias travas:",
              file=sys.stderr)
        for f in proibidos:
            print("  " + f, file=sys.stderr)
        print("Essas mudancas sao de mao humana. Relate ao Joao.", file=sys.stderr)
        return ERRO

    for d, _ in levadas:
        destino = Path(d["destino"])
        destino.parent.mkdir(parents=True, exist_ok=True)
        io.open(destino, "w", encoding="utf-8", newline="\n").write(d["depois"])
        git("add", str(destino.relative_to(repo())))
    corpo = "\n".join("- @%s: %s (+%d/-%d)" % (d["bot"], d["skill"], r["entrou"], r["saiu"])
                      for d, r in levadas)
    git("commit", "-m", "chore(skills): %d melhoria(s) de bot, aprovadas pelo skill-review"
        % len(levadas), "-m", corpo + "\n\nSEGURO = nao removeu trava, nao mexeu em "
        "permissao, versao subiu, e a skill e do proprio bot.")
    print("\ncommit criado. `git push` quando quiser.")
    return OK


def cmd_quarentena(a):
    sk = raiz_hermes() / "profiles" / a.bot / "skills" / a.skill
    if not sk.is_dir():
        print("nao achei %s" % sk, file=sys.stderr)
        return USO
    guarda = pasta_pendentes() / "quarentena" / ("%s__%s__%s" % (
        a.bot, a.skill, datetime.now().strftime("%Y%m%d-%H%M%S")))
    guarda.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(sk, guarda)
    shutil.rmtree(sk)
    (guarda / "MOTIVO.txt").write_text(
        (a.motivo or "sem motivo") + "\n", encoding="utf-8")
    print("@%s/%s em quarentena. Copia em %s" % (a.bot, a.skill, guarda))
    return OK


def cmd_conferir(_a):
    """Atribuicao parada: skill de plataforma morando em bot que nao e o dono dela.

    `analisar` ve mudanca; isto ve o arranjo. Uma skill aprovada antes de um papel
    existir continua no bot errado para sempre, e nenhum diff denuncia.
    """
    dono = donos()
    ruins = []
    for skill, bot in sorted(dono.items()):
        if bot in ("*", "?", DONO_DA_PLATAFORMA):
            continue
        alvo = caminho_repo(skill)
        if not alvo:
            continue
        texto = alvo.read_text(encoding="utf-8", errors="replace")
        achados = sorted({m.group(0) for m in PLATAFORMA_VOCAB.finditer(texto)})
        if len(achados) >= 3:          # mencao solta nao conta; o assunto, sim
            ruins.append((skill, bot, achados))
    if not ruins:
        print("nenhuma skill de plataforma fora do @%s" % DONO_DA_PLATAFORMA)
        return OK
    for skill, bot, achados in ruins:
        print("[GATE] %-30s esta com @%s e fala de plataforma" % (skill, bot))
        print("       sinais: %s" % ", ".join(achados[:5]))
        print("       mover para @%s, ou dizer por que fica" % DONO_DA_PLATAFORMA)
    return OK


def _diff_staged(caminhos) -> dict:
    """{arquivo: (saiu, entrou)} do que esta em stage sob esses caminhos."""
    nomes = git("diff", "--cached", "--name-only", "--", *caminhos).stdout.split()
    fora = {}
    for n in nomes:
        d = git("diff", "--cached", "-U0", "--", n).stdout.splitlines()
        saiu = [l[1:] for l in d if l.startswith("-") and not l.startswith("---")]
        entrou = [l[1:] for l in d if l.startswith("+") and not l.startswith("+++")]
        fora[n] = (saiu, entrou)
    return fora


def _degrau(m):
    """Degrau de preco de um id de modelo, ou None se nao reconhecido."""
    return next((v for k, v in DEGRAU.items() if k in m), None)


def _modelos_de(arq, texto):
    """{bot: (modelo, fixo)} declarado num arquivo, seja config.yaml ou o gerador.

    Compara-se o ESTADO dos dois lados, nunca as linhas do diff. A primeira versao
    somava os modelos que saiam e os que entravam em conjuntos e comparava o maior de
    cada lado — com os nove bots no mesmo `gen_bots.py`, descer o @po de sonnet para
    haiku empatava o maior-que-saiu em opus e escondia o @pm subindo de haiku para opus
    no mesmo commit. Pareado por bot isso nao acontece.

    `fixo` tambem e por bot, e por isso tem de sair daqui: procurar a marca no arquivo
    inteiro funciona no config.yaml (um bot por arquivo) e erra feio no gerador, que
    carrega a marca dentro do proprio template e marcaria os nove.
    """
    a = arq.replace("\\", "/")
    if a.endswith("config.yaml"):
        bot = a.split("/")[-2] if "/" in a else a
        m = re.search(r'^\s*default:\s*["\']?([^"\'\s]+)', texto, re.M)
        return {bot: (m.group(1), _FIXO in texto)} if m else {}
    if a.endswith("scripts/gen_bots.py"):
        # Varre na ordem: cada `"<bot>": {` abre um bloco, e o primeiro `"model"` depois
        # dele e o daquele bot. Nao usa ast porque o gerador tambem e editado por bot e
        # um arquivo em estado intermediario nao pode derrubar o guardiao.
        fora, atual = {}, None
        for l in texto.splitlines():
            b = re.match(r'\s{4}"([a-z-]+)":\s*\{', l)
            if b:
                atual = b.group(1)
                continue
            if not atual:
                continue
            m = re.search(r'"model":\s*"([^"]+)"', l)
            if m and atual not in fora:
                fora[atual] = [m.group(1), False]
            elif '"model_fixo"' in l and atual in fora:
                fora[atual][1] = True
        return {k: tuple(v) for k, v in fora.items()}
    return {}


def _catraca_modelo(arq, antes, depois):
    """Troca de modelo: descer pode, subir nao. Devolve os motivos para NEGAR.

    A regra vem do humano e e assimetrica de proposito: modelo mais barato que der
    conta e economia, e da para medir no dia seguinte; modelo mais caro e gasto que
    ninguem autorizou, decidido pelo mesmo bot que seria julgado por ele.
    """
    de, para = _modelos_de(arq, antes), _modelos_de(arq, depois)
    motivos = []
    for bot, (novo_m, fixo) in sorted(para.items()):
        velho = de.get(bot, (None, False))[0]
        if velho == novo_m:
            continue
        if fixo or de.get(bot, (None, False))[1]:
            # Nem descer passa: `model_fixo` diz que o modelo esta ali pelo que o papel
            # exige, nao pelo preco. O @orquestrador le entrada externa nao confiavel;
            # modelo mais fraco ali economiza e perde justamente o julgamento que
            # justifica o bot existir.
            motivos.append("@%s tem modelo fixado por motivo de papel, nao de preco "
                           "(%s -> %s)" % (bot, velho or "nenhum", novo_m))
            continue
        d_novo, d_velho = _degrau(novo_m), _degrau(velho or "")
        if d_velho is None:
            # Sem degrau do lado de onde se sai: ou o bot nao declarava modelo, ou estava
            # em `auto` (kiro-acp), cuja conta nem passa pelo state.db
            # (`custo-plataforma cego`). Nos dois casos nao e "descer de nada" — e mudar
            # de conta, com preco que ninguem comparou. Quem decide isso e o humano.
            motivos.append("@%s sai de %s, que nao tem preco medido aqui, para %s — "
                           "trocar de conta e decisao sua"
                           % (bot, velho or "nenhum modelo declarado", novo_m))
            continue
        if d_novo is None:
            # Falha fechada: modelo fora da tabela pode ser mais caro que o atual, e
            # degrau faltando nao e autorizacao para subir.
            motivos.append("@%s vai para um modelo que a tabela de degraus nao conhece "
                           "(%s) — acrescente o degrau antes de trocar" % (bot, novo_m))
            continue
        if d_novo > d_velho:
            motivos.append("@%s sobe o degrau do modelo (%s -> %s)"
                           % (bot, velho, novo_m))
    return motivos


def cmd_guardiao(a):
    """Barra no COMMIT o que mexe em autoridade: SOUL e shared-skill.

    O `analisar` compara profile contra repo e so ve skill de bot. SOUL e shared-skill
    sao editados direto no repo — e e neles que mora a autoridade do time. O
    @manutencao commita na main sozinho, entao relatar depois nao segura nada: tem que
    barrar antes de entrar.

    NEGA se o commit apaga uma linha que existia para impedir algo. AVISA (e deixa
    passar) quando so acrescenta texto que fala de permissao: restringir-se e legitimo,
    e barrar isso mataria justamente as boas mudancas.
    """
    alvos = ["souls/", "bots/", "shared-skills/", "scripts/gen_bots.py"]
    mudancas = _diff_staged(alvos)
    if not mudancas:
        return OK
    negar, avisar = [], []
    for arq, (saiu, entrou) in mudancas.items():
        padrao = arq.replace("\\", "/").endswith("config.yaml")
        if padrao or arq.replace("\\", "/").endswith("scripts/gen_bots.py"):
            antes = git("show", "HEAD:%s" % arq, check=False).stdout
            depois = git("show", ":%s" % arq, check=False).stdout
            for m in _catraca_modelo(arq, antes, depois):
                negar.append((arq, m))
        for l in saiu:
            # `config.yaml` guarda a autoridade em forma de maquina, nao de prosa: uma
            # linha de deny que sai afrouxa permissao sem dizer "nao" em lugar nenhum,
            # e a TRAVA, que le portugues, passaria batido. Entao em config.yaml a
            # regra e posicional: entrada de deny que desaparece e trava removida.
            # Acrescentar deny continua livre — so a saida e barrada.
            if padrao and _ENTRADA_DENY.match(l):
                negar.append((arq, l.strip()))
            elif TRAVA.search(l):
                negar.append((arq, l.strip()))
        for l in entrou:
            if PERMISSAO.search(l):
                avisar.append((arq, l.strip()))
    for arq, l in avisar[:6]:
        print("  aviso  %s: fala de permissao — %s" % (arq, l[:90]), file=sys.stderr)
    if not negar:
        return OK
    print("\nskill-review: COMMIT RECUSADO — apaga trava de autoridade:", file=sys.stderr)
    for arq, l in negar[:10]:
        print("  %s" % arq, file=sys.stderr)
        print("    - %s" % l[:110], file=sys.stderr)
    print("\nLinha que existe para impedir algo nao sai por decisao de bot. Se ela esta",
          file=sys.stderr)
    print("errada, quem tira e o humano. Para o humano forcar: --forcar.", file=sys.stderr)
    return ERRO if not a.forcar else OK


def cmd_pendentes(_a):
    fs = sorted(pasta_pendentes().glob("*.json"))
    if not fs:
        print("nada esperando voce")
        return OK
    for f in fs:
        d = json.loads(f.read_text(encoding="utf-8"))
        print("[%s] @%s / %s  (%s)" % (d["veredito"], d["bot"], d["skill"], d["em"][:16]))
        for m in d["motivos"]:
            print("    %s" % m)
        print("    diff: diff \"%s\" \"%s\"" % (d["destino"] or "(nova)", d["arquivo"]))
    return OK


def main(argv):
    ap = argparse.ArgumentParser(prog="skill-review")
    s = ap.add_subparsers(dest="cmd", required=True)
    s.add_parser("colher").set_defaults(f=cmd_colher)
    p = s.add_parser("analisar"); p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_analisar)
    p = s.add_parser("aplicar"); p.add_argument("--sim", action="store_true")
    p.set_defaults(f=cmd_aplicar)
    p = s.add_parser("quarentena")
    p.add_argument("bot"); p.add_argument("skill"); p.add_argument("--motivo")
    p.set_defaults(f=cmd_quarentena)
    s.add_parser("conferir").set_defaults(f=cmd_conferir)
    p = s.add_parser("guardiao")
    p.add_argument("--forcar", action="store_true",
                   help="deixa passar mesmo apagando trava (so humano)")
    p.set_defaults(f=cmd_guardiao)
    s.add_parser("pendentes").set_defaults(f=cmd_pendentes)
    a = ap.parse_args(argv)
    try:
        return a.f(a)
    except RuntimeError as e:
        print("skill-review: %s" % e, file=sys.stderr)
        return ERRO


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
