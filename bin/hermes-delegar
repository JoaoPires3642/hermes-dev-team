#!/usr/bin/env python3
"""hermes-delegar — dá trabalho a outro bot numa sessão NOVA, na pasta do cliente.

  hermes-delegar <bot> <projeto> <KEY> <handoff.md> [--esperar] [--timeout MIN]
  hermes-delegar status <projeto> [<KEY>]
  hermes-delegar reconciliar                # rodadas "rodando" cujo processo morreu → perdida + aviso

Por que isto existe
-------------------
A `Bot Chat` é uma por bot, eterna, e junta todos os clientes: com três clientes, a
tarefa do C chega dentro da conversa de A e B, e quando enche o Hermes compacta tudo
junto. Então trabalho não vai por `message_agent`: vai por aqui, que abre

    hermes -p <bot> chat --in <projeto> --continue <KEY>-<bot> --create-if-missing \\
      --query-file <prompt> --oneshot -Q

— sessão com nome próprio por tarefa e por bot, na pasta do cliente, com o AGENTS.md
dele e nenhum histórico de outro cliente. O nome faz a MESMA tarefa retomar a MESMA
conversa (ajuste pedido no gate volta com o contexto certo).

E porque é código, e não o bot rodando `hermes -p` cru, as regras valem sempre:
  - a pasta tem que ser projeto (AGENTS.md) e ficar dentro de $HERMES_PROJETOS;
  - o handoff tem que morar na pasta da tarefa (.hermes/tasks/<KEY>/handoffs/);
  - o bot só é chamado no estado do manifest em que é a vez dele (tabela PODE) —
    ninguém chega no dev antes do GATE 2, porque o hermes-task não deixa o estado
    chegar lá sem o humano.

Roda em segundo plano por padrão: volta na hora, e um supervisor destacado espera o
bot, grava o resultado em <projeto>/.hermes/runs/<KEY>/ e avisa no Telegram quando
há gate a aprovar, falha, timeout ou BLOCKED. `--esperar` roda em primeiro plano.

Códigos de saída: 0 ok · 1 negado/erro · 2 uso · 4 já tem uma rodada desse bot nessa tarefa
"""
import argparse
import datetime as dt
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

import yaml
# No Windows cada subprocess abre uma janela de console que pisca na tela. Numa rodada
# de teste sao centenas; num turno de bot, uma a cada ferramenta chamada. Este flag
# existe so no Windows; nos outros sistemas o valor e 0 e nao muda nada.
SEM_JANELA = getattr(subprocess, "CREATE_NO_WINDOW", 0)


for _fluxo in (sys.stdout, sys.stderr):
    try:
        _fluxo.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, OSError):
        pass

OK, ERRO, USO, OCUPADO = 0, 1, 2, 4
TIMEOUT_PADRAO = int(os.getenv("HERMES_DELEGAR_TIMEOUT_MIN", "45"))
AVISO_PROFILE = os.getenv("HERMES_AVISO_PROFILE", "orquestrador")  # quem fala com o humano
LIMITE_TELEGRAM = 3500  # a API corta em 4096; sobra para cabeçalho

# Em que estado do manifest é a vez de cada bot. Fora disso, negado.
PODE = {
    "orquestrador": {"RECEIVED", "TRIAGED"},             # triagem da call e ajuste do GATE 1
    "pm": {"SPECIFYING"},                                # pós-GATE 1: cria as issues no TUPLE
    "po": {"TRIAGED", "SPECIFYING"},                     # antes do GATE 1: proposta; depois: docs BMAD
    "techlead": {"SPECIFYING", "SPEC_APPROVED"},         # story + DoR; pós-GATE 2: specs
    "dev-front": {"IMPLEMENTING", "CHANGES_REQUESTED"},
    "dev-back": {"IMPLEMENTING", "CHANGES_REQUESTED"},
    "qa": {"TESTING"},
}

# Quem, ao terminar, tem obrigação de mover o estado. Terminar sem mover é aviso.
DEVE_MOVER = {"orquestrador", "techlead", "qa"}


def agora():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def raiz_hermes():
    env = os.getenv("HERMES_HOME")
    raiz = Path(env) if env else (
        Path(os.getenv("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "hermes"
        if sys.platform == "win32" else Path.home() / ".hermes")
    return raiz.parent.parent if raiz.parent.name == "profiles" else raiz


def cfg(nome):
    """Variável do ambiente ou, na falta, do ~/.hermes/.env. O gateway roda como serviço
    (systemd / tarefa do Windows) e não herda o shell do usuário: sem isto, o comando que
    chega do Telegram não saberia onde ficam os projetos e as calls."""
    v = os.getenv(nome)
    if v:
        return v
    f = raiz_hermes() / ".env"
    if f.is_file():
        for linha in f.read_text(encoding="utf-8", errors="replace").splitlines():
            if linha.startswith(nome + "="):
                return os.path.expanduser(linha.split("=", 1)[1].strip().strip('"\''))
    return None


def die(msg, code=ERRO):
    print(f"hermes-delegar: {msg}", file=sys.stderr)
    sys.exit(code)


def audit(root, **ev):
    try:
        (root / ".hermes").mkdir(exist_ok=True)
        with open(root / ".hermes" / "audit.jsonl", "a", encoding="utf-8") as f:
            f.write(json.dumps({"ts": agora(), **ev}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def dentro(filho, pai):
    try:
        Path(filho).resolve().relative_to(Path(pai).resolve())
        return True
    except ValueError:
        return False


def projeto(p):
    root = Path(p).expanduser().resolve()
    if not (root / "AGENTS.md").is_file():
        die(f"{root} não é pasta de projeto (sem AGENTS.md)", USO)
    base = cfg("HERMES_PROJETOS")
    if base and not dentro(root, Path(base).expanduser()):
        die(f"{root} está fora de $HERMES_PROJETOS ({base})")
    return root


def manifest(root, key):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", key):
        die(f"KEY inválida: {key}", USO)
    mf = root / ".hermes" / "tasks" / key / "manifest.yaml"
    if not mf.is_file():
        die(f"tarefa não existe: {mf} (crie com hermes-task new)")
    return mf


def ler_estado(mf):
    try:
        m = yaml.safe_load(mf.read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError):
        return None, {}
    return m.get("estado"), m


def hermes_bin():
    h = shutil.which("hermes")
    if not h:
        die("não achei o `hermes` no PATH")
    return h


def vivo(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if sys.platform == "win32":
        r = subprocess.run(["tasklist", "/FI", f"PID eq {pid}", "/NH"], capture_output=True, text=True, encoding="utf-8", errors="replace", creationflags=SEM_JANELA)
        return str(pid) in r.stdout
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def gravar(path, dados):
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(json.dumps(dados, ensure_ascii=False, indent=1), encoding="utf-8")
    os.replace(tmp, path)


# ------------------------------------------------------------------ Telegram
def avisar(texto, anexo=None):
    """Manda para o humano pelo Telegram do @orquestrador. Falhar aqui não derruba nada:
    sem Telegram configurado, o aviso fica só no registro da rodada."""
    h = shutil.which("hermes")
    if not h:
        return False
    if len(texto) > LIMITE_TELEGRAM:
        texto = texto[:LIMITE_TELEGRAM] + "\n…(cortado)"
    ok = False
    for i in range(3):   # timeout isolado do Telegram não pode engolir um gate
        try:
            ok = subprocess.run([h, "-p", AVISO_PROFILE, "send", "--to", "telegram", "-q", "--file", "-"],
                                input=texto, text=True, encoding="utf-8", errors="replace", capture_output=True, timeout=60, creationflags=SEM_JANELA).returncode == 0
        except subprocess.TimeoutExpired:
            ok = False
        if ok:
            break
        time.sleep(3 * (i + 1))
    if ok and anexo and Path(anexo).is_file():
        subprocess.run([h, "-p", AVISO_PROFILE, "send", "--to", "telegram", "-q", f"MEDIA:{anexo}"],
                       capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=60, creationflags=SEM_JANELA)
    return ok


JANELA_AGRUPAR = 600   # s: falha igual dentro disto não gera outro aviso


def assinatura(bot, texto):
    """O mesmo erro em rodadas diferentes vira a mesma assinatura: tira números, ids e
    caminhos, que mudam de rodada para rodada."""
    t = re.sub(r"[0-9a-f]{6,}|\d+|/[^\s:]+", "", texto.casefold())
    return f"{bot}:{' '.join(t.split())[-300:]}"


def avisar_agrupado(sig, key, texto, anexo=None):
    """Manda o 1º aviso de uma falha; as iguais nos próximos 10 min só entram na conta.
    Cinco issues falhando pelo mesmo motivo eram cinco mensagens idênticas no Telegram."""
    f = raiz_hermes() / "hermes-delegar-avisos.json"
    try:
        vistos = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        vistos = {}
    agora_s = time.time()
    vistos = {k: v for k, v in vistos.items() if agora_s - v["em"] < JANELA_AGRUPAR}
    if sig in vistos:
        vistos[sig]["keys"] = sorted(set(vistos[sig]["keys"]) | {key})
        gravar(f, vistos)
        return "agrupado"
    vistos[sig] = {"em": agora_s, "keys": [key]}
    gravar(f, vistos)
    return avisar(texto + "\n\n(falha igual em outras tarefas nos próximos 10 min não gera outro aviso; "
                          "veja `hermes-delegar status <projeto>`)", anexo)


def provedor(bot):
    try:
        cfgy = yaml.safe_load((raiz_hermes() / "profiles" / bot / "config.yaml").read_text(encoding="utf-8"))
        return ((cfgy or {}).get("model") or {}).get("provider")
    except (OSError, yaml.YAMLError):
        return None


def cauda(path, linhas=12):
    try:
        return "\n".join(Path(path).read_text(encoding="utf-8", errors="replace").splitlines()[-linhas:])
    except OSError:
        return ""


MARCA_RESUMO = re.compile(
    r"^\s*(?:#+\s*)?(?:\*\*)?resumo\b(?:\s*\([^)]*\))?\s*:?\s*(?:\*\*)?\s*:?\s*$"
    r"|^\s*-{2,}\s*resumo\s*-{2,}\s*$", re.I)


def resumo_da_rodada(path, linhas=14):
    """So o resumo final do bot, nao a sessao inteira.

    O prompt pede "termine com um resumo" e o bot obedece — escreve uma secao `Resumo:`
    no fim. O codigo e que mandava `read_text()` inteiro para o Telegram: em 01/10 os
    seis GATE 2 da skymark sairam com 41 a 51 linhas cada, abrindo com narracao interna
    em ingles ("Let me verify the exact lines I'll cite...", "The && routed to
    PowerShell again"). Com o gate ilegivel, o humano aprovou pela lista do
    @orquestrador em vez do texto — e aprovou uma issue que o @techlead recomendava
    cancelar.

    Dois dos seis nao emitiram marcador nenhum, entao o fallback nao e luxo: sem
    marcador devolve a cauda, que e onde o resumo esta mesmo quando nao se anuncia.
    """
    try:
        todas = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    # de baixo para cima: vale o ULTIMO marcador. Bot que fala de "resumo" no meio da
    # investigacao nao deve cortar o texto ali.
    for i in range(len(todas) - 1, -1, -1):
        if MARCA_RESUMO.match(todas[i]):
            corpo = "\n".join(todas[i + 1:]).strip()
            if corpo:
                return corpo
    return "\n".join(todas[-linhas:]).strip()


def artefato(root, m, nome):
    v = ((m.get("artefatos") or {}).get(nome) or "")
    if not v:
        return None
    p = Path(v).expanduser()
    p = p if p.is_absolute() else root / p
    return p if p.is_file() else None


def toques(key):
    """Comandos prontos para tocar no Telegram (só letra, número e _ viram link)."""
    t = key.replace("-", "_")
    if not re.fullmatch(r"[A-Za-z0-9_]+", t):
        return f"/aprovar {key}\n/ajustar {key} <o que mudar>\n/rejeitar {key} <motivo>"
    return f"/aprovar_{t}\n/ajustar_{t}\n/rejeitar_{t}"


VAGAS = int(os.getenv("HERMES_DELEGAR_VAGAS", "4"))
# Quantas rodadas de bot podem rodar ao mesmo tempo no MESMO projeto.
#
# Quatro e o que o Joao disse que serve. Em 01/10 sete subiram em 2m41s no skymark
# e tres nunca escreveram um byte — a
# sessao do kiro era criada e o backend nunca entregava. Os quatro que trabalharam
# brigaram pelo unico working tree e misturaram o codigo de tres tarefas. Nao e que
# paralelo nao sirva: e que SETE nao serve, e a conta nao estava em lugar nenhum.
#
# Quem passa do limite ESPERA a vaga, nao e recusado: o trabalho ja foi decidido e
# recusar aqui perderia o handoff. A espera e no supervisor, que ja roda solto, entao
# ninguem fica preso na frente. Nao ha risco de travar todos de uma vez porque quem
# espera ainda nao tem vaga, e o @techlead nao fica parado enquanto despacha (o
# `destacar` devolve o turno dele na hora).
MUDO_MIN = int(os.getenv("HERMES_DELEGAR_MUDO_MIN", "8"))
# Minutos de silencio TOTAL (zero byte em stdout e stderr) que ja contam como rodada
# morta. Em 01/10 sete devs subiram em 2m41s no mesmo repo e tres nunca escreveram um
# byte: o err.log tinha uma linha so, "Session <id> found but has no messages. Starting
# fresh.", e depois nada. Cada um ficou os 45 minutos do timeout e foi morto sem ter
# feito nada — 135 minutos de espera para zero trabalho, e o estado da tarefa ficou em
# IMPLEMENTING sem ninguem nela.
#
# Rodada viva escreve: o kiro imprime a sessao nos primeiros segundos e o bot narra
# enquanto trabalha. Silencio absoluto por 8 minutos nao e bot pensando, e bot que nao
# subiu. Falhar rapido devolve a vaga para o proximo e avisa o humano enquanto ele ainda
# esta olhando.

ESPERA_LOTE = 1200   # 20 min: depois disso manda o que tem, mesmo com irmao pendurado


def _pasta_lote(root):
    d = root / ".hermes" / "gates-pendentes"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _irmas(root, call):
    """{key: estado} das issues que nasceram da mesma call."""
    fora = {}
    for mf in (root / ".hermes" / "tasks").glob("*/manifest.yaml"):
        try:
            mm = yaml.safe_load(mf.read_text(encoding="utf-8")) or {}
        except (OSError, yaml.YAMLError):
            continue
        g1 = ((mm.get("aprovacoes") or {}).get("gate1") or {})
        if g1.get("herdado_de") == call:
            fora[mm.get("task_id")] = mm.get("estado")
    return fora


def lote_gate2(root, m, key, resumo, story):
    """Junta os GATE 2 da mesma call numa mensagem so.

    Em 01/10 as seis issues da skymark chegaram ao GATE 2 em 70 segundos, cada uma como
    mensagem propria de 40+ linhas. O humano respondeu "aprovado" em texto livre, o
    @orquestrador listou os seis comandos achatando as perguntas em seis linhas iguais,
    e a OUVI-154 — em que o @techlead recomendava CANCELAR — foi aprovada junto.

    Seguram-se os gates enquanto alguma irma da mesma call ainda esta em `SPECIFYING`
    (o @techlead dela ainda trabalhando). A ultima a terminar manda o lote. Nao ha
    daemon nem timer: cada rodada reavalia, e o teto de 1200s existe para o caso de
    uma irma morrer em SPECIFYING e nunca liberar o lote.

    Devolve (texto, anexo) quando e hora de mandar, ou (None, None) enquanto segura.
    """
    call = ((m.get("aprovacoes") or {}).get("gate1") or {}).get("herdado_de")
    if not call:
        return None, None            # issue solta: quem chamou manda como sempre
    arq = _pasta_lote(root) / f"{call}.json"
    try:
        guardado = json.loads(arq.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        guardado = {"itens": {}}
    # `em` e a hora da PRIMEIRA vez. Renovar a cada rodada faria o teto de
    # ESPERA_LOTE nunca vencer: a issue que volta ao gate (ajuste, retry)
    # empurraria o prazo para frente e o lote ficaria preso num arquivo que
    # ninguem olha.
    ja = (guardado["itens"].get(key) or {}).get("em")
    guardado["itens"][key] = {"em": ja or time.time(), "resumo": resumo,
                              "story": story,
                              "objetivo": (m.get("objetivo") or "")[:80]}
    arq.write_text(json.dumps(guardado, ensure_ascii=False, indent=1), encoding="utf-8")

    irmas = _irmas(root, call)
    faltam = sorted(k for k, e in irmas.items() if e == "SPECIFYING")
    velho = min((i["em"] for i in guardado["itens"].values()), default=time.time())
    if faltam and time.time() - velho < ESPERA_LOTE:
        return None, None

    arq.unlink(missing_ok=True)
    itens = guardado["itens"]
    quantas = ("1 issue esperando você" if len(itens) == 1
               else f"{len(itens)} issues esperando você")
    cab = f"🚦 GATE 2 · [{root.name}] {call} · {quantas}"
    if faltam:
        cab += f"\n\n⚠️ {', '.join(faltam)} travou em SPECIFYING e não entrou neste lote."
    blocos = []
    for k in sorted(itens):
        it = itens[k]
        bloco = f"── {k} · {it.get('objetivo') or ''}\n{it['resumo']}"
        if it.get("story"):
            bloco += f"\nStory: {it['story']}"
        blocos.append(bloco)
    rodape = ("Por issue: `/aprovar <KEY>` · `/ajustar <KEY> <o quê>` · "
              "`/rejeitar <KEY> <motivo>` · `/atendido <KEY> <motivo>` (já está pronto)")
    return "\n\n".join([cab] + blocos + [rodape]), None


def aviso_final(reg, m):
    """O que o humano precisa saber depois da rodada — gate, falha ou silêncio suspeito."""
    root, key, bot = Path(reg["projeto"]), reg["key"], reg["bot"]
    antes, depois = reg["estado_antes"], reg["estado_depois"]
    resposta = resumo_da_rodada(reg["saida"])
    bruto = Path(reg["saida"]).read_text(encoding="utf-8", errors="replace").strip() \
        if Path(reg["saida"]).is_file() else ""
    cab = f"[{root.name}] {key}"

    if reg["status"] != "ok":
        motivo = {"timeout": "passou do tempo",
                  "mudo": f"nao escreveu nada em {MUDO_MIN} min — a sessao nao subiu"}.get(
                      reg["status"], f"saiu com {reg['exit']}")
        # Falha quer o fim do log cru: o bot pode nem ter chegado a escrever resumo.
        return (f"❌ {cab} · @{bot} {motivo}.\n\n{cauda(reg['erros']) or bruto[-800:]}\n\n"
                f"Log: {reg['erros']}"), None

    if depois == "AWAITING_APPROVAL" and antes != depois:
        novo = "<!-- hermes: projeto novo, a preencher -->" in \
            (root / "AGENTS.md").read_text(encoding="utf-8", errors="replace")
        if novo or not (root / ".hermes" / "tuple.env").is_file():
            resposta += (f"\n\n⚠️ Projeto novo: antes do /aprovar, preencha {root / 'AGENTS.md'} "
                         f"e {root / '.hermes' / 'tuple.env'} (chave do TUPLE). Sem isso o /aprovar recusa.")
        return (f"🚦 GATE 1 · {cab}\n\n{resposta}\n\n" + toques(key)), \
            artefato(root, m, "proposta")
    if depois == "AWAITING_SPEC_APPROVAL" and antes != depois:
        story = (m.get("artefatos") or {}).get("story")
        texto, anexo = lote_gate2(root, m, key, resposta, story)
        if texto:
            return texto, anexo
        if ((m.get("aprovacoes") or {}).get("gate1") or {}).get("herdado_de"):
            return None, None        # segurando o lote; a ultima irma manda tudo
        return (f"🚦 GATE 2 · {cab}\n\n{resposta}\n\n" + toques(key)), \
            artefato(root, m, "story")
    if depois == "AWAITING_REVIEW" and antes != depois:
        pr = (m.get("artefatos") or {}).get("pr") or "?"
        return (f"✅ GATE 3 · {cab} passou no QA (DoD aceito pelo hermes-task).\n\n"
                f"PR para você revisar e fazer o merge: {pr}\n\n{resposta[-1200:]}"), None
    if depois == "CLOSED" and antes != depois and key.upper().startswith("CALL-"):
        ult = (m.get("historico") or [{}])[-1]
        ev = ult.get("evidencias") or {}
        if ev.get("sem_trabalho"):
            # Quem decide "não é trabalho" é um bot; o humano não aprovou nada, então é ele
            # quem precisa poder desfazer. Sem este aviso a call sumiria calada.
            return (f"🗒 {cab} · sem trabalho a criar, nenhuma issue.\n\n"
                    f"Motivo (@{ult.get('por')}): {ev['sem_trabalho']}\n"
                    f"Guardado em: {ev.get('memoria') or '?'}\n\n"
                    f"Se era trabalho de verdade, a call precisa ser reaberta por você: "
                    f"ainda não existe /reabrir, então peça ao @manutencao."), None
        return (f"✅ {cab} concluída: issues {ev.get('issues') or '?'} criadas e com o @techlead.\n\n"
                f"{resposta[-1200:]}"), None
    if depois == "BLOCKED" and antes != depois:
        ult = (m.get("historico") or [{}])[-1]
        motivo = (ult.get("evidencias") or {}).get("motivo") or ult.get("por") or "?"
        return f"⛔ {cab} BLOCKED por @{bot}: {motivo}\n\n{resposta[-1500:]}", None
    # GATE 2 dispensado: o @techlead disse que nao havia o que decidir e seguiu. Nao e
    # gate, e aviso — mas tem de chegar, porque uma etapa de controle deixou de
    # acontecer e quem precisa poder discordar e o humano, antes de o dev terminar.
    # Procura no historico, nao em `depois`: na mesma rodada ele costuma seguir para
    # SPEC_APPROVED e IMPLEMENTING, e o estado final nao conta essa historia.
    disp = next((h for h in reversed(m.get("historico") or [])
                 if h.get("de") == "SPECIFYING" and h.get("para") == "SPEC_APPROVED"), None)
    if disp and antes == "SPECIFYING" and depois != "SPECIFYING":
        porque = (disp.get("evidencias") or {}).get("sem_decisoes") or "nao disse"
        return (f"➡️ {cab} · GATE 2 dispensado — nada a decidir, foi direto para o dev.\n\n"
                f"Motivo (@{disp.get('por')}): {porque}\n\n{resposta}\n\n"
                f"Discorda? `/ajustar {key} <o que mudar>` traz a story de volta; "
                f"`/atendido {key} <motivo>` encerra se o trabalho nao deveria existir."), \
            artefato(root, m, "story")
    if (bot in DEVE_MOVER or (bot == "po" and antes == "TRIAGED")) and antes == depois:
        return (f"⚠️ {cab} · @{bot} terminou sem mover a tarefa (segue em {depois}).\n\n"
                f"{resposta[-1500:]}\n\nSaída: {reg['saida']}"), None
    return None, None


# ------------------------------------------------------------------ rodada
PROMPT = """Você foi chamado pelo `hermes-delegar` para a tarefa {key} do projeto abaixo.
Esta é uma sessão só desta tarefa: não existe conversa de outro cliente aqui.

- Projeto (seu diretório atual): {projeto}
- Tarefa: {key} — estado agora: {estado}
- Handoff desta etapa: {handoff}

Antes de agir: leia o AGENTS.md do projeto, o handoff acima e o manifest
(`hermes-task show "{projeto}" {key}`). Siga seu SOUL e as skills `fluxo-time` e
`estado-tarefa`. Mude o estado só com `hermes-task`.

Para passar o trabalho adiante: escreva o próximo handoff em
{projeto}/.hermes/tasks/<KEY>/handoffs/<NN>-{bot}-para-<bot>.md e rode
`hermes-delegar <bot> "{projeto}" <KEY> <handoff>`. Não use `message_agent` para
trabalho, e não mande o gate para o humano: quem manda é o hermes-delegar, quando o
estado chegar lá.

Termine com uma linha contendo só `Resumo:` e, abaixo dela, no máximo 8 linhas — é
só isso que vai para o humano no Telegram, o resto da sua saída não vai. Sem essa
linha, o Telegram recebe o rabo da sua saída como estiver.

Se há algo que só o humano decide, o resumo tem que **dizer qual é a pergunta e quais
são as opções**. Resumo que termina em "aguardando aprovação" não diz nada: quem lê
precisa saber o que está respondendo.

--- handoff ---
{conteudo}
"""


def preparar(a):
    bot = a.bot.lstrip("@")
    if bot not in PODE:
        die(f"bot desconhecido: {bot} (existem: {', '.join(PODE)})", USO)
    root = projeto(a.projeto)
    mf = manifest(root, a.key)
    estado, _ = ler_estado(mf)
    if estado not in PODE[bot]:
        audit(root, tipo="delegar-negado", task=a.key, bot=bot, estado=estado)
        die(f"NEGADO: @{bot} não entra em {a.key} no estado {estado} "
            f"(a vez dele é em: {', '.join(sorted(PODE[bot]))})")
    if provedor(bot) == "kiro-acp" and not shutil.which("kiro-cli"):
        # sem isto o bot sobe, o kiro-pool tenta 3 vezes e só então falha — por issue
        audit(root, tipo="delegar-negado", task=a.key, bot=bot, motivo="kiro-cli ausente")
        avisar_agrupado(f"{bot}:kiro-cli-ausente", a.key,
                        f"❌ [{root.name}] @{bot} não pode rodar: `kiro-cli` não está instalado nesta "
                        f"máquina (é o cérebro dele). Instale e rode `kiro-cli login`; depois repita o passo.")
        die(f"@{bot} usa o kiro-cli, que não está instalado nesta máquina. O humano foi avisado; "
            f"não tente de novo — registre na issue que parou aqui")
    handoff = Path(a.handoff).expanduser()
    handoff = (handoff if handoff.is_absolute() else Path.cwd() / handoff).resolve()
    pasta_ok = root / ".hermes" / "tasks" / a.key / "handoffs"
    if not handoff.is_file() or not dentro(handoff, pasta_ok):
        die(f"handoff tem que existir dentro de {pasta_ok}")

    runs = root / ".hermes" / "runs" / a.key
    runs.mkdir(parents=True, exist_ok=True)
    trava = runs / f"{bot}.lock"
    if trava.exists():
        pid = trava.read_text(encoding="utf-8", errors="replace").strip()
        if vivo(pid):
            die(f"@{bot} já está rodando em {a.key} (pid {pid}); espere terminar", OCUPADO)
        trava.unlink(missing_ok=True)   # trava de rodada que morreu

    ts = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    base = runs / f"{ts}-{bot}"
    prompt = Path(str(base) + ".prompt.md")
    prompt.write_text(PROMPT.format(
        key=a.key, projeto=root, estado=estado, handoff=handoff, bot=bot,
        conteudo=handoff.read_text(encoding="utf-8", errors="replace")), encoding="utf-8")
    reg = {
        "bot": bot, "projeto": str(root), "key": a.key, "sessao": f"{a.key}-{bot}",
        "handoff": str(handoff), "prompt": str(prompt), "estado_antes": estado,
        "estado_depois": None, "status": "agendado", "exit": None,
        "criado": agora(), "inicio": None, "fim": None,
        "timeout_min": a.timeout, "trava": str(trava),
        "saida": str(base) + ".out.md", "erros": str(base) + ".err.log",
    }
    arq = Path(str(base) + ".json")
    gravar(arq, reg)
    audit(root, tipo="delegar", task=a.key, bot=bot, estado=estado, handoff=str(handoff))
    return arq


def supervisionar(arq):
    arq = Path(arq)
    reg = json.loads(arq.read_text(encoding="utf-8"))
    root, bot = Path(reg["projeto"]), reg["bot"]
    trava = Path(reg["trava"])
    # A vaga e pedida ANTES de marcar a trava: quem espera nao ocupa lugar.
    reg["esperou_min"] = esperar_vaga(root, trava)
    if reg["esperou_min"]:
        gravar(arq, reg)
    trava.write_text(str(os.getpid()), encoding="utf-8")
    cmd = [hermes_bin(), "-p", bot, "chat", "--in", str(root),
           "--continue", reg["sessao"], "--create-if-missing",
           "--query-file", reg["prompt"], "--oneshot", "-Q"]
    reg.update(status="rodando", inicio=agora(), cmd=cmd, supervisor_pid=os.getpid())
    gravar(arq, reg)
    # No Windows os flags se combinam com OR num UNICO creationflags. Passar um
    # segundo argumento apaga o primeiro em silencio: foi assim que o
    # CREATE_NEW_PROCESS_GROUP se perdeu e as rodadas de fundo pararam de terminar.
    extra = {"start_new_session": True} if sys.platform != "win32" else \
        {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP | SEM_JANELA}
    try:
        with open(reg["saida"], "w", encoding="utf-8") as out, \
                open(reg["erros"], "w", encoding="utf-8") as err:
            proc = subprocess.Popen(cmd, cwd=root, stdin=subprocess.DEVNULL, stdout=out, stderr=err, **extra)
            try:
                code = esperar(proc, reg)
                reg["status"] = "ok" if code == 0 else "falhou"
            except Mudo:
                matar(proc)
                code = None
                reg["status"] = "mudo"
            except subprocess.TimeoutExpired:
                matar(proc)
                code = None
                reg["status"] = "timeout"
        reg["exit"] = code
    except OSError as e:
        reg.update(status="falhou", exit=None, erro=str(e))
    finally:
        trava.unlink(missing_ok=True)

    estado, m = ler_estado(root / ".hermes" / "tasks" / reg["key"] / "manifest.yaml")
    reg.update(fim=agora(), estado_depois=estado)
    texto, anexo = aviso_final(reg, m)
    if texto and reg["status"] != "ok":
        sig = assinatura(bot, cauda(reg["saida"], 4) + cauda(reg["erros"], 4))
        reg["avisado"] = avisar_agrupado(sig, reg["key"], texto, anexo)
    elif texto:
        reg["avisado"] = avisar(texto, anexo)
    gravar(arq, reg)
    audit(root, tipo="delegar-fim", task=reg["key"], bot=bot, status=reg["status"],
          de=reg["estado_antes"], para=estado)
    return OK if reg["status"] == "ok" else ERRO


class Mudo(Exception):
    """Rodada que nao escreveu nada por MUDO_MIN minutos: nao subiu."""


def rodando_no_projeto(root, menos=None):
    """Rodadas de bot vivas neste projeto, pelos `.lock` com pid de processo vivo."""
    base = root / ".hermes" / "runs"
    n = 0
    for l in (base.glob("*/*.lock") if base.is_dir() else []):
        if menos and l == menos:
            continue
        try:
            pid = l.read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            continue
        if vivo(pid):
            n += 1
    return n


def esperar_vaga(root, trava, limite_min=40):
    """Segura a rodada ate o projeto ter menos de VAGAS bots rodando.

    Devolve quantos minutos esperou. Passado `limite_min`, desiste de esperar e deixa
    passar: ficar preso para sempre e pior que um bot a mais — e um lock esquecido de
    processo que o `vivo()` nao conseguiu ler derrubaria o projeto inteiro.
    """
    if VAGAS <= 0:
        return 0
    comeco = time.time()
    while rodando_no_projeto(root, menos=trava) >= VAGAS:
        if time.time() - comeco >= limite_min * 60:
            return int((time.time() - comeco) / 60)
        time.sleep(15)
    return int((time.time() - comeco) / 60)


def esperar(proc, reg):
    """`proc.wait` com teto de silencio, nao so de tempo total.

    Espera em fatias e olha o tamanho dos dois arquivos de saida. Cresceu em alguma
    fatia -> o bot esta vivo, zera o relogio do silencio. Nao cresceu por MUDO_MIN ->
    `Mudo`. O timeout total continua valendo para a rodada que escreve e nao termina.
    """
    limite = time.time() + int(reg["timeout_min"]) * 60
    fatia = 20
    marca = time.time()
    tamanho = -1
    while True:
        agora_s = time.time()
        if agora_s >= limite:
            raise subprocess.TimeoutExpired(reg.get("cmd"), int(reg["timeout_min"]) * 60)
        try:
            return proc.wait(timeout=min(fatia, max(1, limite - agora_s)))
        except subprocess.TimeoutExpired:
            pass
        atual = 0
        for k in ("saida", "erros"):
            try:
                atual += os.path.getsize(reg[k])
            except OSError:
                pass
        if atual != tamanho:
            tamanho, marca = atual, time.time()
        elif time.time() - marca >= MUDO_MIN * 60:
            raise Mudo()


def matar(proc):
    """Timeout: derruba o bot e tudo que ele abriu (kiro-cli, terminal, testes)."""
    try:
        if sys.platform == "win32":
            subprocess.run(["taskkill", "/T", "/F", "/PID", str(proc.pid)], capture_output=True, creationflags=SEM_JANELA)
        else:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.wait(timeout=15)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
    except (OSError, ProcessLookupError):
        pass


def destacar(arq):
    """Solta o supervisor do processo que chamou: o bot que delegou termina o turno
    dele, e a rodada do outro segue sozinha."""
    cmd = [sys.executable, os.path.abspath(__file__), "_supervisionar", str(arq)]
    if sys.platform == "win32":
        flags = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, creationflags=flags, close_fds=True)
    else:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)


FOLGA_AGENDADO = 120   # s: "agendado" sem supervisor depois disto não vai mais começar


def reconciliar_arquivo(f):
    """Rodada marcada "rodando"/"agendado" cujo supervisor não existe mais (máquina
    reiniciou, processo morto) nunca terminaria sozinha: vira "perdida" e avisa. Sem
    isto a issue fica parada com cara de que alguém está trabalhando nela."""
    try:
        r = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if r.get("status") not in ("rodando", "agendado"):
        return None
    if r.get("status") == "rodando" and vivo(r.get("supervisor_pid")):
        return None
    if r.get("status") == "agendado":
        try:
            idade = time.time() - dt.datetime.fromisoformat(r["criado"]).timestamp()
        except (KeyError, ValueError):
            idade = FOLGA_AGENDADO + 1
        if idade < FOLGA_AGENDADO:
            return None
    root = Path(r["projeto"])
    estado, _ = ler_estado(root / ".hermes" / "tasks" / r["key"] / "manifest.yaml")
    r.update(status="perdida", fim=agora(), estado_depois=estado)
    Path(r["trava"]).unlink(missing_ok=True) if r.get("trava") else None
    r["avisado"] = avisar_agrupado(
        f"{r['bot']}:perdida", r["key"],
        f"⚠️ [{root.name}] {r['key']} · a rodada do @{r['bot']} morreu sem terminar (máquina "
        f"reiniciou ou o processo caiu). A tarefa segue em {estado}. Refaça o último passo "
        f"— um /aprovar repetido retoma o disparo, quando é o caso.")
    gravar(f, r)
    audit(root, tipo="delegar-perdida", task=r["key"], bot=r["bot"], estado=estado)
    return r


def cmd_reconciliar(_a=None):
    base = cfg("HERMES_PROJETOS")
    if not base:
        die("HERMES_PROJETOS não definido", USO)
    n = 0
    for f in Path(base).expanduser().glob("*/.hermes/runs/*/*.json"):
        if reconciliar_arquivo(f):
            n += 1
            print(f"perdida: {f}")
    print(f"{n} rodada(s) perdida(s)", file=sys.stderr)
    return OK


def cmd_status(a):
    root = projeto(a.projeto)
    base = root / ".hermes" / "runs"
    alvos = [base / a.key] if a.key else sorted(p for p in base.glob("*") if p.is_dir())
    for d in alvos:
        for f in sorted(d.glob("*.json"))[-10:]:
            reconciliar_arquivo(f)
            r = json.loads(f.read_text(encoding="utf-8"))
            print(f"{r['key']:14} @{r['bot']:12} {r['status']:9} {r['estado_antes'] or '?'} → "
                  f"{r['estado_depois'] or '…'}  {r['criado']}")
    return OK


def main(argv):
    if argv[:1] == ["_supervisionar"]:
        return supervisionar(argv[1])
    if argv[:1] == ["reconciliar"]:
        return cmd_reconciliar()
    if argv[:1] == ["status"]:
        ap = argparse.ArgumentParser(prog="hermes-delegar status")
        ap.add_argument("projeto"); ap.add_argument("key", nargs="?")
        return cmd_status(ap.parse_args(argv[1:]))
    ap = argparse.ArgumentParser(prog="hermes-delegar", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("bot"); ap.add_argument("projeto"); ap.add_argument("key"); ap.add_argument("handoff")
    ap.add_argument("--esperar", action="store_true", help="roda em primeiro plano e devolve o código do bot")
    ap.add_argument("--timeout", type=int, default=TIMEOUT_PADRAO, help="minutos (padrão %(default)s)")
    a = ap.parse_args(argv)
    arq = preparar(a)
    if a.esperar:
        return supervisionar(arq)
    destacar(arq)
    reg = json.loads(arq.read_text(encoding="utf-8"))
    print(f"@{reg['bot']} disparado em {reg['key']} (sessão {reg['sessao']}). "
          f"Resultado: {arq}. O humano é avisado no Telegram se houver gate, falha ou BLOCKED.")
    return OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
