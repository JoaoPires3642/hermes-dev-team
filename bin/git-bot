#!/usr/bin/env python3
"""git-bot — as operações git do time, com as regras em código em vez de prosa.

Existe por dois motivos:

1. **Determinismo.** "nunca --force", "pull --rebase antes de todo push" e "sem
   --no-verify" eram texto na skill `git-workflow`: valiam se o modelo resolvesse
   obedecer. Aqui são código. Isso importa porque as `permissions` dos agentes Kiro
   só são aplicadas na engine v3, e o `acp` não aceita v3 junto com `--agent`.
2. **Tokens.** Um `push` seguro é fetch + pull --rebase + checar conflito + push.
   Em prosa são 4 a 6 tool calls e o raciocínio da sequência a cada vez; aqui é uma.

  git-bot estado   <repo>
  git-bot preparar <repo> --key KEY --slug SLUG --estrategia por-tarefa|compartilhada
                          --base BRANCH [--branch BRANCH] --nome NOME --email EMAIL
  git-bot commit   <repo> --key KEY --tipo feat --desc "texto" [--escopo api] [--bot dev-back]
  git-bot push     <repo>

Saída: 0 ok · 1 erro · 2 uso/falta informação · 3 BLOCKED (só humano destrava)

O que ele se recusa a fazer, sempre: --force, --force-with-lease, --no-verify,
--no-gpg-sign, reset --hard, git config --global, push em main/master, e commitar
arquivo que pareça segredo. Não há flag para desligar isso — é o ponto.
"""
import argparse
import hashlib
import os
import re
import subprocess
import sys
from pathlib import Path
# No Windows cada subprocess abre uma janela de console que pisca na tela. Numa rodada
# de teste sao centenas; num turno de bot, uma a cada ferramenta chamada. Este flag
# existe so no Windows; nos outros sistemas o valor e 0 e nao muda nada.
SEM_JANELA = getattr(subprocess, "CREATE_NO_WINDOW", 0)


TIPOS = ("feat", "fix", "chore", "docs", "refactor", "perf", "test",
         "build", "ci", "style", "revert")
BRANCHES_PROIBIDAS = ("main", "master")
# nome de arquivo que não entra em commit de bot
SEGREDOS = re.compile(
    r"(^|/)\.env(\.|$)|\.pem$|\.p12$|\.pfx$|(^|/)id_rsa|(^|/)\.npmrc$|"
    r"(^|/)\.netrc$|secrets?\.(ya?ml|json)$|credentials?\.(ya?ml|json)$", re.I)
PERIGO = re.compile(r"--force|--no-verify|--no-gpg-sign|--hard|\s-f(\s|$)", re.I)
# marca de bot no commit — proibida. Cobre "[bot @dev-front]", "(bot @qa)", "@bot",
# "por @techlead" e as variações que apareceram na prática.
MARCA_BOT = re.compile(
    r"[\[\(]\s*bot\b[^\]\)]*[\]\)]|@(?:bot|orquestrador|po|pm|techlead|qa|dev-front|"
    r"dev-back|arquiteto)\b|\bbot\s+@", re.I)

OK, ERRO, USO, BLOCKED = 0, 1, 2, 3

# stdout do Windows é cp1252 por padrão e engasga em emoji: o script morreria ao
# imprimir, não ao fazer git. O shell dos bots lê esta saída, então ela tem que sair.
for _fluxo in (sys.stdout, sys.stderr):
    try:
        _fluxo.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, OSError):
        pass


def fim(codigo, msg):
    cor = {OK: "1;32", ERRO: "1;31", USO: "1;33", BLOCKED: "1;35"}[codigo]
    rotulo = {OK: "ok", ERRO: "erro", USO: "falta", BLOCKED: "BLOCKED"}[codigo]
    print("\033[%sm[%s]\033[0m %s" % (cor, rotulo, msg),
          file=sys.stderr if codigo else sys.stdout)
    sys.exit(codigo)


def sem_dialogo():
    """Ambiente em que o git FALHA em vez de perguntar.

    No Windows o git abre janela — o CredentialHelperSelector, o prompt de senha do
    Git Credential Manager — e um processo de bot fica preso nela para sempre. Em
    30/09 o @dev-front escreveu o código, foi fazer o push e sumiu: 0 s de CPU, log
    mudo, e só 45 minutos depois o watchdog desconfiaria. Ninguém viu a janela porque
    ninguém estava olhando a tela.

    Falhar em dois segundos com "não consegui autenticar" é melhor que pendurar:
    o erro vira handoff, o humano resolve, e o turno não morre de pé.
    """
    env = dict(os.environ)
    env["GIT_TERMINAL_PROMPT"] = "0"   # não pergunta no terminal
    env["GCM_INTERACTIVE"] = "never"   # Git Credential Manager: nada de janela
    env["GIT_ASKPASS"] = "echo"        # askpass que devolve vazio na hora
    env["SSH_ASKPASS"] = "echo"
    env.pop("DISPLAY", None)
    return env


def git(repo, *args, checar=True):
    """Roda git. Recusa qualquer argumento perigoso, venha de onde vier."""
    alvo = " ".join(args)
    if PERIGO.search(alvo):
        fim(ERRO, "recusado: argumento proibido em 'git %s'" % alvo)
    p = subprocess.run(["git", "-C", str(repo), "-c", "credential.interactive=false", *args],
                       capture_output=True, text=True, encoding="utf-8", errors="replace",
                       env=sem_dialogo(), timeout=180, creationflags=SEM_JANELA)
    if checar and p.returncode:
        fim(ERRO, "git %s falhou:\n%s" % (alvo, (p.stderr or p.stdout).strip()))
    return p


def conferir_repo(caminho):
    repo = Path(caminho).resolve()
    if not (repo / ".git").exists():
        fim(USO, "%s não é um repositório git" % repo)
    return repo


def branch_atual(repo):
    return git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()


# ------------------------------------------------------------------ worktrees
# Um working tree por repo e quatro devs em paralelo = brigam pela mesma árvore: a branch
# trocada por baixo de quem estava nela, e o `git add -A` varrendo arquivo de outra tarefa
# (OUVI-148/149/154, 01/10). Cada TAREFA tem o seu working tree; a árvore principal fica
# para humano. Vive FORA do OneDrive: o sync disputa o .git e o node_modules de cada uma.
KEY_OK = re.compile(r"[A-Za-z0-9._-]+")


def raiz_worktrees():
    env = os.environ.get("HERMES_WORKTREES")
    if env:
        return Path(env)
    base = os.environ.get("LOCALAPPDATA")
    return (Path(base) / "hermes" / "worktrees") if base else Path.home() / ".hermes-worktrees"


def repo_principal(repo):
    """O repo de verdade, mesmo quando `repo` é um worktree (o .git dele é um arquivo)."""
    comum = git(repo, "rev-parse", "--git-common-dir").stdout.strip()
    comum = Path(comum) if Path(comum).is_absolute() else Path(repo) / comum
    return comum.resolve().parent


def pasta_worktree(principal, key):
    rid = hashlib.sha1(str(principal).lower().encode()).hexdigest()[:6]
    return raiz_worktrees() / ("%s-%s" % (principal.name, rid)) / key


def worktrees_do_repo(principal):
    """[(caminho, branch)] dos worktrees ligados ao repo, sem o principal."""
    out, atual = [], {}
    for linha in git(principal, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if not linha.strip():
            if atual.get("worktree") and Path(atual["worktree"]).resolve() != principal:
                out.append((Path(atual["worktree"]), atual.get("branch", "").replace("refs/heads/", "")))
            atual = {}
        elif " " in linha:
            k, v = linha.split(" ", 1)
            atual[k] = v
    return out


def alvo_de_push(repo, br):
    """Branch REMOTA para onde esta árvore publica. Em `compartilhada` a local é wt/<KEY> e o
    destino é a do time, guardada no config da branch; nas demais é a própria."""
    r = git(repo, "config", "--local", "branch.%s.hermes-alvo" % br, checar=False)
    return r.stdout.strip() or br


def dono_do_worktree(repo):
    """KEY da tarefa dona desta árvore, ou None se não é um worktree de tarefa.
    Pelo caminho: <raiz>/<repo>-<id>/<KEY>[/subpasta]."""
    try:
        rel = Path(repo).resolve().relative_to(raiz_worktrees().resolve())
    except ValueError:
        return None
    return rel.parts[1] if len(rel.parts) >= 2 else None


# --------------------------------------------------------------------- estado
def cmd_estado(a):
    repo = conferir_repo(a.repo)
    br = branch_atual(repo)
    sujo = git(repo, "status", "--porcelain").stdout.strip()
    git(repo, "fetch", "--quiet", checar=False)
    upstream = git(repo, "rev-parse", "--abbrev-ref", "@{u}", checar=False)
    tem_up = upstream.returncode == 0

    print("branch:    %s%s" % (br, "  ⚠️ PROIBIDA" if br in BRANCHES_PROIBIDAS else ""))
    print("upstream:  %s" % (upstream.stdout.strip() if tem_up else "(nenhum)"))
    if tem_up:
        c = git(repo, "rev-list", "--left-right", "--count", "@{u}...HEAD").stdout.split()
        if len(c) == 2:
            print("atrás/à frente: %s / %s" % (c[0], c[1]))
    print("identidade: %s <%s>" % (
        git(repo, "config", "--local", "user.name", checar=False).stdout.strip() or "(não definida)",
        git(repo, "config", "--local", "user.email", checar=False).stdout.strip() or "(não definida)"))
    if sujo:
        print("\nalterações pendentes:")
        print(sujo)
    else:
        print("\nárvore limpa")


# ------------------------------------------------------------------- preparar
def alinhar_com_remoto(arvore, nome):
    """pull --rebase se a branch tem upstream e a árvore está limpa; conflito aborta e vira BLOCKED."""
    if git(arvore, "rev-parse", "--abbrev-ref", "@{u}", checar=False).returncode:
        return
    if git(arvore, "status", "--porcelain").stdout.strip():
        return    # trabalho em andamento do próprio dev: não mexe
    r = git(arvore, "pull", "--rebase", checar=False)
    if r.returncode:
        conflitos = git(arvore, "diff", "--name-only", "--diff-filter=U", checar=False).stdout.strip()
        git(arvore, "rebase", "--abort", checar=False)
        fim(BLOCKED, "conflito ao alinhar '%s' com o remoto; rebase abortado, nada foi alterado. "
                     "Arquivos: %s" % (nome, conflitos or "?"))


def preparar_worktree(repo, a, destino):
    """Um working tree por TAREFA, fora do repo principal. Idempotente: dev que morreu e voltou
    recebe o mesmo caminho, com o trabalho dele dentro.

    A mesma branch não pode estar em dois worktrees. Em `compartilhada` há uma branch do time e
    N tarefas, então cada árvore usa uma local `wt/<KEY>` e publica na do time (alvo_de_push)."""
    if not KEY_OK.fullmatch(a.key):
        fim(USO, "--key '%s' inválida (só letras, números, ponto, hífen e sublinhado)" % a.key)
    principal = repo_principal(repo)
    pasta = pasta_worktree(principal, a.key)
    local = destino if a.estrategia == "por-tarefa" else "wt/%s" % a.key
    git(principal, "fetch", "--quiet", checar=False)

    ligados = {p.resolve(): b for p, b in worktrees_do_repo(principal)}
    if pasta.resolve() in ligados:
        if ligados[pasta.resolve()] != local:
            fim(BLOCKED, "o worktree de %s já existe em '%s' mas está na branch '%s', não em '%s'. "
                         "Não vou trocar: há trabalho lá." % (a.key, pasta, ligados[pasta.resolve()], local))
        alinhar_com_remoto(pasta, local)
    elif pasta.exists():
        fim(BLOCKED, "'%s' existe mas não é um worktree deste repo; remova à mão ou escolha outra "
                     "raiz em HERMES_WORKTREES." % pasta)
    else:
        pasta.parent.mkdir(parents=True, exist_ok=True)
        existe = git(principal, "rev-parse", "--verify", "--quiet", "refs/heads/" + local,
                     checar=False).returncode == 0
        remota = git(principal, "rev-parse", "--verify", "--quiet", "origin/" + destino,
                     checar=False).returncode == 0
        if existe:
            cmd = ["worktree", "add", str(pasta), local]
        elif remota:
            cmd = ["worktree", "add", "-b", local, str(pasta), "origin/" + destino]
        else:
            # --no-track: sem isso a branch nova rastreia a BASE e o push dela viraria
            # pull --rebase do develop + um `git push` que o git recusa (nome diferente).
            cmd = ["worktree", "add", "--no-track", "-b", local, str(pasta), "origin/" + a.base]
        r = git(principal, *cmd, checar=False)
        if r.returncode:
            fim(BLOCKED, "não consegui criar o worktree de %s:\n%s\n"
                         "Se a branch '%s' está em uso na árvore principal, quem está nela precisa "
                         "terminar (ou um humano liberar); não force." %
                (a.key, (r.stderr or r.stdout).strip(), local))
        alinhar_com_remoto(pasta, local)

    git(pasta, "config", "--local", "branch.%s.hermes-alvo" % local, destino)
    print("worktree: %s" % pasta)
    dica = ""
    if (pasta / "pnpm-lock.yaml").exists() and not (pasta / "node_modules").exists():
        dica = " node_modules não existe aqui: pnpm install --offline --frozen-lockfile (store compartilhado)."
    fim(OK, "worktree de %s pronto (branch '%s' → publica em '%s', identidade %s <%s>). "
            "Trabalhe SÓ nesse caminho: edite os arquivos dentro dele e passe-o como <repo> a "
            "commit e push.%s" % (a.key, local, destino, a.nome, a.email, dica))


def cmd_preparar(a):
    repo = conferir_repo(a.repo)
    for campo, valor in (("--nome", a.nome), ("--email", a.email), ("--base", a.base)):
        if not valor:
            fim(USO, "%s é obrigatório (está no AGENTS.md do projeto; se estiver "
                     "em branco, pergunte ao humano — não invente)" % campo)

    # identidade SEMPRE local: --global é proibido e nem é oferecido
    git(repo, "config", "--local", "user.name", a.nome)
    git(repo, "config", "--local", "user.email", a.email)

    if a.estrategia == "por-tarefa":
        if not (a.key and a.slug):
            fim(USO, "por-tarefa exige --key e --slug")
        destino = "feature/%s-%s" % (a.key.lower(), a.slug)
    else:
        if not a.branch:
            fim(USO, "compartilhada exige --branch (a branch do time, do AGENTS.md)")
        destino = a.branch

    if destino in BRANCHES_PROIBIDAS:
        fim(ERRO, "recusado: '%s' é branch protegida, bot não trabalha nela" % destino)

    if a.key:
        preparar_worktree(repo, a, destino)    # não volta: termina com fim()

    # GUARDA DE COLISÃO — o piso, para quem chega aqui sem --key (e portanto sem worktree).
    #
    # Há UM working tree por repo. Quando dois bots rodam em paralelo no mesmo
    # projeto, o segundo trocava a branch por baixo do primeiro: `git checkout`
    # CARREGA as alterações não commitadas para a branch nova quando não há
    # conflito de conteúdo, então o código do primeiro dev reaparecia na branch do
    # segundo. Aconteceu de verdade (OUVI-148 preparou a sua branch às 13:12 e às
    # 13:18 virou a branch da OUVI-154, com os arquivos dos dois misturados).
    #
    # Recusar é a única saída segura: `stash` automático esconderia trabalho alheio
    # e `checkout --force` o destruiria. Trocar de branch com árvore suja só é
    # inofensivo quando já estamos na branch pedida (é o WIP do próprio dev).
    atual = branch_atual(repo)
    sujo = git(repo, "status", "--porcelain").stdout.strip()
    if sujo and atual != destino:
        arquivos = [l[3:] for l in sujo.splitlines()[:8]]
        fim(BLOCKED,
            "recusado: a árvore está em '%s' com alteração não commitada e esta tarefa "
            "quer '%s'. Trocar de branch agora levaria o trabalho de quem está nela.\n"
            "Arquivos: %s\n"
            "Destrava: outro bot/humano commitar o que é dele, OU dar um working tree "
            "separado por branch (git worktree). Não force, não stashe o que não é seu."
            % (atual, destino, ", ".join(arquivos) or "?"))

    git(repo, "fetch", "--quiet", checar=False)
    existe = git(repo, "rev-parse", "--verify", "--quiet", destino, checar=False).returncode == 0
    if existe:
        git(repo, "checkout", destino)
        # Branch local já existia: o fetch acima só moveu origin/*, não a local. Sem
        # isto o dev começa a escrever em cima de código velho e só descobre no rebase
        # do push — tarde, e com conflito que ninguém pediu. Em branch compartilhada
        # (vários devs e humanos no mesmo ramo) isso é a regra, não o zelo extra.
        tem_up = git(repo, "rev-parse", "--abbrev-ref", "@{u}", checar=False).returncode == 0
        if tem_up:
            if git(repo, "status", "--porcelain").stdout.strip():
                fim(USO, "árvore suja em '%s' — commite ou guarde antes de preparar "
                         "(seria preciso rebase para alinhar com o remoto)" % destino)
            r = git(repo, "pull", "--rebase", checar=False)
            if r.returncode:
                conflitos = git(repo, "diff", "--name-only", "--diff-filter=U",
                                checar=False).stdout.strip()
                git(repo, "rebase", "--abort", checar=False)
                fim(BLOCKED, "conflito ao alinhar '%s' com o remoto; rebase abortado, "
                             "nada foi alterado. Arquivos: %s" % (destino, conflitos or "?"))
    else:
        remota = git(repo, "rev-parse", "--verify", "--quiet",
                     "origin/" + destino, checar=False).returncode == 0
        if remota:
            git(repo, "checkout", "-b", destino, "origin/" + destino)
        else:
            git(repo, "checkout", "-b", destino, "origin/" + a.base)
    fim(OK, "branch '%s' pronta, identidade local %s <%s>" % (destino, a.nome, a.email))


# --------------------------------------------------------------------- commit
def cmd_commit(a):
    repo = conferir_repo(a.repo)
    br = branch_atual(repo)
    if br in BRANCHES_PROIBIDAS:
        fim(ERRO, "recusado: commit direto em '%s'" % br)

    if a.tipo not in TIPOS:
        fim(USO, "tipo inválido '%s' — use um de: %s" % (a.tipo, ", ".join(TIPOS)))

    # Dentro de um worktree de tarefa, só a KEY dele. A árvore é da tarefa: um commit com outra
    # `Refs:` aqui é exatamente a mistura que o worktree existe para impedir.
    dono = dono_do_worktree(repo)
    if dono and dono != a.key:
        fim(ERRO, "recusado: esta árvore é do worktree de %s e o commit cita %s. Cada tarefa "
                  "trabalha no próprio worktree; rode `git-bot preparar --key %s` e use o caminho "
                  "que ele imprime." % (dono, a.key, a.key))

    desc = a.desc.strip().rstrip(".")
    if not desc:
        fim(USO, "--desc vazio")
    if desc[0].isupper():
        desc = desc[0].lower() + desc[1:]
    cabecalho = "%s(%s): %s" % (a.tipo, a.escopo, desc) if a.escopo else "%s: %s" % (a.tipo, desc)
    if len(cabecalho) > 72:
        fim(USO, "cabeçalho tem %d caracteres (máx. 72): %s" % (len(cabecalho), cabecalho))

    git(repo, "add", "-A")
    staged = [l for l in git(repo, "diff", "--cached", "--name-only").stdout.splitlines() if l]
    if not staged:
        fim(USO, "nada para commitar")

    suspeitos = [f for f in staged if SEGREDOS.search(f)]
    if suspeitos:
        git(repo, "reset", checar=False)
        fim(ERRO, "recusado: arquivo com cara de segredo no commit:\n  " +
                  "\n  ".join(suspeitos) + "\nAjuste o .gitignore e tente de novo.")

    # O histórico do repo é do time, não do Hermes. Um commit que anuncia "[bot @nome]"
    # muda como a pessoa do outro lado lê o código — e o `git log` é para sempre, ao
    # contrário do board, onde a marca de bot faz sentido porque distingue quem
    # escreveu o comentário. Aqui não: commit é commit.
    # Recusa em vez de remover calado: se a mensagem traz a marca, quem a montou está
    # seguindo uma regra velha, e apagar sem avisar deixaria a regra velha de pé.
    if MARCA_BOT.search(cabecalho):
        fim(USO, "recusado: o cabeçalho traz marca de bot (%r).\n"
                 "Commit não leva assinatura de bot — isso é do comentário na issue."
                 % MARCA_BOT.search(cabecalho).group(0))
    corpo = "Refs: %s" % a.key
    git(repo, "commit", "-m", cabecalho, "-m", corpo)
    sha = git(repo, "rev-parse", "--short", "HEAD").stdout.strip()
    print("%s  %s" % (sha, cabecalho))
    print("arquivos: %d" % len(staged))
    fim(OK, "commit criado em '%s' (hooks rodaram; --no-verify não existe aqui)" % br)


# ----------------------------------------------------------------------- push
def cmd_push(a):
    repo = conferir_repo(a.repo)
    br = branch_atual(repo)
    if br in BRANCHES_PROIBIDAS:
        fim(ERRO, "recusado: push em '%s'" % br)
    if git(repo, "status", "--porcelain").stdout.strip():
        fim(USO, "árvore suja — commite antes de dar push")

    git(repo, "fetch", "--quiet", checar=False)
    alvo = alvo_de_push(repo, br)
    if alvo != br:
        # compartilhada: árvore em wt/<KEY>, publica na branch do time. Rebase em cima dela
        # antes de todo push e nunca force — a mesma regra, com o destino explícito.
        if git(repo, "rev-parse", "--verify", "--quiet", "origin/" + alvo, checar=False).returncode == 0:
            r = git(repo, "pull", "--rebase", "origin", alvo, checar=False)
            if r.returncode:
                conflitos = git(repo, "diff", "--name-only", "--diff-filter=U", checar=False).stdout.strip()
                git(repo, "rebase", "--abort", checar=False)
                fim(BLOCKED, "conflito no rebase — rebase abortado, nada foi enviado.\n"
                             "Arquivos em conflito:\n  %s\n"
                             "Regra do time: bot não resolve conflito de código alheio. "
                             "Marque a issue como BLOCKED e avise o humano."
                             % (conflitos.replace("\n", "\n  ") or "(não listados)"))
        git(repo, "push", "origin", "HEAD:refs/heads/" + alvo)
        sha = git(repo, "rev-parse", "--short", "HEAD").stdout.strip()
        fim(OK, "push de '%s' para '%s' feito (%s), sem force" % (br, alvo, sha))
    tem_up = git(repo, "rev-parse", "--abbrev-ref", "@{u}", checar=False).returncode == 0

    if tem_up:
        # a regra da branch compartilhada: rebase antes de todo push, nunca force
        r = git(repo, "pull", "--rebase", checar=False)
        if r.returncode:
            conflitos = git(repo, "diff", "--name-only", "--diff-filter=U",
                            checar=False).stdout.strip()
            git(repo, "rebase", "--abort", checar=False)
            fim(BLOCKED, "conflito no rebase — rebase abortado, nada foi enviado.\n"
                         "Arquivos em conflito:\n  %s\n"
                         "Regra do time: bot não resolve conflito de código alheio. "
                         "Marque a issue como BLOCKED e avise o humano."
                         % (conflitos.replace("\n", "\n  ") or "(não listados)"))
        git(repo, "push")
    else:
        git(repo, "push", "--set-upstream", "origin", br)

    sha = git(repo, "rev-parse", "--short", "HEAD").stdout.strip()
    fim(OK, "push de '%s' feito (%s), sem force" % (br, sha))


def main():
    ap = argparse.ArgumentParser(description="Operações git do time de bots, com as regras em código.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("estado", help="branch, upstream, divergência e pendências numa chamada")
    p.add_argument("repo"); p.set_defaults(func=cmd_estado)

    p = sub.add_parser("preparar", help="identidade local + branch de trabalho")
    p.add_argument("repo")
    p.add_argument("--key"); p.add_argument("--slug")
    p.add_argument("--estrategia", choices=("por-tarefa", "compartilhada"), required=True)
    p.add_argument("--base"); p.add_argument("--branch")
    p.add_argument("--nome"); p.add_argument("--email")
    p.set_defaults(func=cmd_preparar)

    p = sub.add_parser("commit", help="Conventional Commits validado + Refs + trava de segredo")
    p.add_argument("repo")
    p.add_argument("--key", required=True)
    p.add_argument("--tipo", required=True)
    p.add_argument("--desc", required=True)
    p.add_argument("--escopo")
    # --bot fica aceito e IGNORADO de proposito: quem ja chama com ele nao quebra,
    # e a marca simplesmente nao entra mais no commit. Removê-lo faria o comando
    # falhar por argumento desconhecido, que e pior que ignorar em silencio aqui.
    p.add_argument("--bot", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_commit)

    p = sub.add_parser("push", help="fetch + pull --rebase + push; conflito vira BLOCKED")
    p.add_argument("repo"); p.set_defaults(func=cmd_push)

    a = ap.parse_args()
    a.func(a)


if __name__ == "__main__":
    main()
