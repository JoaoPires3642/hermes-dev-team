#!/usr/bin/env bash
# kiro-pool — limita quantas sessões kiro-cli rodam ao mesmo tempo.
#
# Uso: kiro-pool <args do kiro-cli...>        (ex.: kiro-pool acp --agent hermes-dev-back)
# O provider kiro-acp chama isto no lugar do kiro-cli (HERMES_KIRO_ACP_COMMAND=kiro-pool).
#
# Segura uma de N vagas (flock) durante toda a vida do processo kiro-cli; se todas
# estiverem ocupadas, espera na fila. A vaga fica presa (fd 9) enquanto o kiro-cli
# roda e é liberada quando o pool sai, logo depois de registrar o fim da sessão.
#
# Variáveis:
#   KIRO_POOL_SLOTS   número de vagas (padrão 4)
#   KIRO_POOL_DIR     onde ficam os locks (padrão $XDG_RUNTIME_DIR/kiro-pool ou /tmp/kiro-pool-$USER)
#   KIRO_POOL_WAIT    segundos máximos de espera na fila (padrão 1800; 0 = infinito)
#   KIRO_CLI          binário real (padrão kiro-cli)
#   KIRO_POOL_AUDIT   log JSONL das sessões (padrão ~/.hermes/dev-team-audit.jsonl)

set -euo pipefail

slots="${KIRO_POOL_SLOTS:-4}"
dir="${KIRO_POOL_DIR:-${XDG_RUNTIME_DIR:-/tmp}/kiro-pool-${USER:-$(id -u)}}"
max_wait="${KIRO_POOL_WAIT:-1800}"
kiro="${KIRO_CLI:-kiro-cli}"
audit="${KIRO_POOL_AUDIT:-$HOME/.hermes/dev-team-audit.jsonl}"

# agente Kiro = bot (vem de "--agent hermes-<bot>")
agent=""; prev=""
for a in "$@"; do [[ "$prev" == "--agent" ]] && agent="$a"; prev="$a"; done

log() {  # log JSONL fora do canal ACP (stdout é JSON-RPC)
  mkdir -p "$(dirname "$audit")"
  printf '{"ts":"%s","tipo":"kiro-sessao","evento":"%s","agente":"%s","vaga":"%s","pid":%s%s}\n' \
    "$(date -Iseconds)" "$1" "$agent" "$2" "$$" "${3:-}" >>"$audit" 2>/dev/null || true
}

mkdir -p "$dir"
waited=0
announced=0

while :; do
  for ((i = 1; i <= slots; i++)); do
    exec 9>"$dir/slot-$i.lock"
    if flock -n 9; then
      # stdout é o canal JSON-RPC do ACP: mensagens do pool só vão para stderr.
      echo "kiro-pool: vaga $i/$slots" >&2
      log inicio "$i" ",\"espera_s\":$waited"
      start=$(date +%s)
      # <&0 explícito: sem ele o bash dá /dev/null como stdin a processos em background
      # e o canal JSON-RPC do ACP morre.
      "$kiro" "$@" <&0 &
      child=$!
      trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
      rc=0; wait "$child" || rc=$?
      while kill -0 "$child" 2>/dev/null; do rc=0; wait "$child" || rc=$?; done
      log fim "$i" ",\"duracao_s\":$(( $(date +%s) - start )),\"saida\":$rc"
      exit "$rc"
    fi
    exec 9>&-
  done
  if [[ $announced -eq 0 ]]; then
    echo "kiro-pool: $slots vagas ocupadas, aguardando na fila..." >&2
    announced=1
  fi
  if [[ $max_wait -gt 0 && $waited -ge $max_wait ]]; then
    echo "kiro-pool: nenhuma vaga livre após ${max_wait}s" >&2
    exit 75
  fi
  sleep 2
  waited=$((waited + 2))
done
